  "title": "LLM-Assist Semantic Layer Action Normalization Issue Analysis",

  "problem_summary": {
    "description": "LLM-Assist가 Sepsis 도메인에서는 100% Compliance를 달성하지만, 다른 도메인(Chest Pain, Stroke, AKI)에서는 0%에 가까운 점수를 받는 문제",
    "root_cause": "도메인별 액션 ID 네이밍 컨벤션 불일치",
    "impact": "Non-sepsis 도메인에서 모든 액션이 DEVIATION 또는 OMISSION 위반으로 처리됨"
  },

  "why_sepsis_works": {
    "reason": "Sepsis CPG와 LLM 출력이 동일한 네이밍 컨벤션 사용",
    "cpg_mandatory_actions": [
      "order_lab_lactate",
      "order_lab_blood_culture",
      "give_broad_spectrum_antibiotics",
      "give_crystalloid_30ml_kg",
      "start_vasopressor_if_hypotensive"
    ],
    "llm_generated_actions": [
      "order_lab_lactate",
      "order_lab_blood_culture",
      "give_crystalloid_30ml_kg",
      "give_broad_spectrum_antibiotics",
      "start_vasopressor_norepinephrine"
    ],
    "matching_pattern": "order_lab_X, give_X, start_vasopressor_X 패턴이 일치",
    "semantic_matching": "start_vasopressor_norepinephrine → start_vasopressor_if_hypotensive (환자가 저혈압일 때)"
  },

  "why_other_domains_fail": {
    "chest_pain": {
      "cpg_mandatory": ["obtain_12_lead_ecg", "assess_vital_signs", "obtain_chest_pain_history"],
      "llm_generates": ["order_imaging_ecg", "order_lab_troponin", "give_aspirin_loading"],
      "mismatch_examples": [
        {"llm": "order_imaging_ecg", "expected": "obtain_12_lead_ecg", "issue": "obtain vs order_imaging prefix"},
        {"llm": "give_aspirin_loading", "expected": "give_aspirin", "issue": "suffix mismatch"},
        {"llm": "activate_cath_lab", "expected": "activate_cath_lab", "issue": "actually matches but not in mandatory set"}
      ]
    },
    "stroke": {
      "cpg_mandatory": ["activate_stroke_team", "perform_nihss", "order_stat_ct_head", "check_glucose"],
      "llm_generates": ["order_ct_head", "assess_nihss", "order_lab_glucose"],
      "mismatch_examples": [
        {"llm": "order_ct_head", "expected": "order_stat_ct_head", "issue": "missing 'stat' qualifier"},
        {"llm": "assess_nihss", "expected": "perform_nihss", "issue": "assess vs perform prefix"},
        {"llm": "order_lab_glucose", "expected": "check_glucose", "issue": "order_lab vs check prefix"}
      ]
    },
    "aki": {
      "cpg_mandatory": ["check_baseline_egfr", "assess_hydration_status", "review_risk_factors"],
      "llm_generates": ["order_lab_creatinine", "assess_aki_risk", "start_iv_hydration"],
      "mismatch_examples": [
        {"llm": "order_lab_creatinine", "expected": "check_baseline_egfr", "issue": "different action entirely"},
        {"llm": "assess_aki_risk", "expected": "review_risk_factors", "issue": "semantically similar but different ID"}
      ]
    }
  },

  "fixes_applied": {
    "fix_1_domain_direct_mappings": {
      "description": "도메인별 직접 매핑 테이블 추가",
      "location": "semantic_layer/action_normalizer.py::_build_domain_direct_mappings()",
      "status": "completed",
      "domains_covered": ["chest_pain", "stroke", "aki", "heart_failure", "sepsis"]
    },
    "fix_2_expanded_default_actions": {
      "description": "기본 액션 목록을 LLM 생성 이름 + CPG 표준 이름 모두 포함하도록 확장",
      "location": "semantic_layer/action_normalizer.py::_get_default_actions()",
      "status": "completed",
      "note": "CPG 표준 이름이 valid_actions에 포함되어 exact match가 작동하도록 함"
    },
    "fix_3_stricter_llm_semantic_matching": {
      "description": "LLM semantic fallback의 잘못된 매칭 문제 해결",
      "location": "semantic_layer/action_normalizer.py::_semantic_match_with_llm()",
      "status": "completed",
      "changes": [
        "confidence threshold 0.5 → 0.85로 상향",
        "administrative actions (transfer, document, etc.) 스킵",
        "프롬프트 강화: semantically identical matches만 허용"
      ],
      "issue_fixed": "transfer_to_icu → start_vasopressor_norepinephrine 같은 잘못된 매칭 방지"
    },
    "fix_4_json_context_length_overflow": {
      "description": "CPG Parser의 JSON 파일 처리 시 context length overflow 해결",
      "location": "semantic_layer/cpg_parser.py::_split_text()",
      "status": "completed",
      "changes": [
        "paragraph break(\\n\\n) 없는 경우 문자 수 기반 분할로 fallback",
        "JSON 구조 고려한 분할 지점 선택 (}, ], \\n, 공백 순)",
        "117K chars → 16 chunks (~2600 tokens/chunk)"
      ],
      "issue_fixed": "33893 tokens > 8192 max context length 오류 해결, 0% cases 제거"
    }
  },


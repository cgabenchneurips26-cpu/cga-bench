      "timestamp_minutes": 10.0,
      "type": "order_imaging",
      "args": {
        "imaging_type": "ecg"
      },
      "justification": "MANDATORY: ECG is required to evaluate for atrial fibrillation or other cardiac arrhythmias which are important in cryptogenic stroke workup (cardioembolic source). Also evaluates for concurrent cardiac ischemia and establishes baseline cardiac status."
    },
    {
      "action_id": "assess_vital_signs",
      "timestamp_minutes": 15.0,
      "type": "reassess",
      "args": {},
      "justification": "AHA stroke guidelines mandate immediate vital sign assessment including BP monitoring. Patient has hypertension with BP 145/88 \u2014 needs close monitoring. BP must be <185/110 before tPA consideration. Neuro status assessment is critical at this phase."
    },
    {
      "action_id": "interpret_ecg",
      "timestamp_minutes": 20.0,
      "type": "order_imaging",
      "args": {
        "imaging_type": "ecg"
      },
      "justification": "12-lead ECG has already been obtained. Interpretation is essential for cryptogenic stroke workup \u2014 atrial fibrillation is a major cardioembolic cause of cryptogenic stroke and must be identified to guide anticoagulation decisions."
    },
    {
      "action_id": "request_cardiology_consult",
      "timestamp_minutes": 25.0,
      "type": "consult",
      "args": {},
      "justification": "For cryptogenic ischemic stroke, cardiology consultation is indicated to evaluate for cardioembolic sources including paroxysmal atrial fibrillation, patent foramen ovale, or other structural cardiac abnormalities that may explain the stroke etiology."
    },
    {
      "action_id": "give_aspirin_loading",
      "timestamp_minutes": 30.0,
      "type": "give_medication",
      "args": {
        "medication_code": "aspirin",
        "dose": "standard"
      },
      "justification": "Aspirin 325mg is indicated for ischemic stroke management. Patient has cryptogenic ischemic stroke and antiplatelet therapy is a key intervention. Administer as early as possible per AHA stroke guidelines, ensuring no tPA is being considered or CT has ruled out hemorrhage."
    },
    {
      "action_id": "administer_oxygen_if_hypoxic",

    {
      "action_id": "establish_iv_access",
      "timestamp_minutes": 5.0,
      "type": "reassess",
      "args": {},
      "justification": "MANDATORY: IV access must be established immediately to enable rapid administration of medications including alteplase if tPA eligible, as well as for lab draws. This is a critical first step in acute stroke management."
    },
    {

      "action_id": "assess_airway",
      "timestamp_minutes": 0.0,
      "type": "reassess",
      "args": {},
      "justification": "Airway assessment is the highest priority in burn patients - inhalation injury or airway edema can be immediately life-threatening and requires early intervention before swelling progresses."
    },
    {
      "action_id": "assess_vital_signs",
      "timestamp_minutes": 5.0,
      "type": "reassess",
      "args": {},
      "justification": "Mandatory baseline vital signs assessment to establish hemodynamic status and guide resuscitation needs in burn patient."
    },
    {
      "action_id": "assess_burn_depth",
      "timestamp_minutes": 10.0,
      "type": "reassess",
      "args": {},
      "justification": "Mandatory assessment to classify burn severity (superficial, partial thickness, full thickness) which determines treatment plan and fluid resuscitation requirements."
    },
    {
      "action_id": "establish_iv_access",
      "timestamp_minutes": 15.0,
      "type": "reassess",
      "args": {},
      "justification": "Mandatory action - IV access is required for fluid resuscitation in burn patients. Large-bore IV access should be established immediately for Parkland formula fluid delivery."
    },
    {
      "action_id": "estimate_tbsa",
      "timestamp_minutes": 20.0,
      "type": "reassess",
      "args": {},
      "justification": "Mandatory action - Total Body Surface Area (TBSA) estimation is essential for calculating fluid resuscitation requirements using the Parkland formula. Must be completed before fluid calculations."
    },
    {
      "action_id": "obtain_patient_weight",
      "timestamp_minutes": 25.0,
      "type": "reassess",
      "args": {},
      "justification": "Mandatory action - Patient weight is required along with TBSA to calculate Parkland formula fluid requirements (4 mL \u00d7 kg \u00d7 %TBSA burned)."
    },
    {
      "action_id": "calculate_parkland_formula",
      "timestamp_minutes": 30.0,
      "type": "reassess",
      "args": {},
      "justification": "Calculate the Parkland formula (4 mL \u00d7 kg \u00d7 %TBSA) to determine total fluid resuscitation volume for the first 24 hours. Half given in first 8 hours, half in next 16 hours. This is the foundational step for burn fluid management."
    },
    {
      "action_id": "place_foley_catheter",
      "timestamp_minutes": 35.0,
      "type": "reassess",
      "args": {},
      "justification": "Place Foley catheter to enable accurate hourly urine output measurement, which is the primary endpoint for guiding fluid resuscitation in burn patients (target 0.5 mL/kg/h in adults)."
    },
    {
      "action_id": "start_lactated_ringers",
      "timestamp_minutes": 40.0,
      "type": "give_medication",
      "args": {
        "medication_code": "unknown",
        "dose": "standard"
      },
      "justification": "Initiate Lactated Ringer's solution per Parkland formula. LR is the preferred resuscitation fluid in burn patients due to its physiologic composition and reduced hyperchloremic acidosis risk compared to normal saline."
    },
    {
      "action_id": "monitor_urine_output_target_0_5_ml_kg_h",
      "timestamp_minutes": 45.0,
      "type": "order_lab",
      "args": {
        "test_code": "unknown"
      },
      "justification": "MANDATORY: Foley catheter is already placed; now must actively monitor urine output targeting 0.5 ml/kg/h as per burn resuscitation guidelines (Parkland formula guide). Adequate urine output is the primary endpoint for fluid resuscitation in burn patients."
    },
    {
      "action_id": "titrate_fluids_to_urine_output",
      "timestamp_minutes": 50.0,
      "type": "give_medication",
      "args": {
        "medication_code": "fluid",
        "dose": "standard"
      },
      "justification": "MANDATORY: Lactated Ringer's infusion rate must be titrated based on urine output. If UO < 0.5 ml/kg/h, increase rate; if > 1 ml/kg/h, decrease rate. This is the standard of care for burn resuscitation per ABA guidelines."
    },
    {
      "action_id": "assess_inhalation_injury_signs",
      "timestamp_minutes": 55.0,
      "type": "reassess",
      "args": {},
      "justification": "Inhalation injury significantly worsens burn prognosis and may require early intubation. Signs include singed nasal hairs, carbonaceous sputum, hoarseness, and facial burns. Airway was assessed but inhalation injury specifically should be evaluated now while patient is stable."
    },
    {
      "action_id": "give_100_percent_oxygen",
      "timestamp_minutes": 60.0,
      "type": "give_medication",
      "args": {
        "medication_code": "unknown",
        "dose": "standard"
      },
      "justification": "Patient with burn injury should receive 100% oxygen via non-rebreather mask to treat potential carbon monoxide poisoning and support oxygenation, especially given inhalation injury assessment was completed."
    },
    {
      "action_id": "assess_burn_center_referral_criteria",
      "timestamp_minutes": 65.0,
      "type": "reassess",
      "args": {},
      "justification": "Evaluate whether this burn patient meets criteria for transfer to a specialized burn center based on TBSA, depth, location, and other factors per ABA guidelines."
    },
    {
      "action_id": "cover_with_clean_dry_dressing",
      "timestamp_minutes": 70.0,
      "type": "reassess",
      "args": {},
      "justification": "Cover burn wounds with clean dry dressings to prevent infection, reduce heat loss, and minimize pain while further management is planned."
    },
    {
      "action_id": "consult_burn_center",
      "timestamp_minutes": 75.0,
      "type": "consult",
      "args": {},
      "justification": "Based on completed burn assessment, consult burn center for definitive care guidance and transfer planning if indicated by burn depth/TBSA findings."
    },
    {
      "action_id": "assess_compartment_pressures",
      "timestamp_minutes": 80.0,
      "type": "reassess",
      "args": {},
      "justification": "Assess for compartment syndrome, especially if circumferential burns were identified, to determine if escharotomy is needed."
    },
    {
      "action_id": "assess_distal_pulses",
      "timestamp_minutes": 85.0,
      "type": "reassess",
      "args": {},
      "justification": "Check distal pulses in burned extremities to evaluate for vascular compromise and need for escharotomy."
    },
    {
      "action_id": "monitor_airway_patency",
      "timestamp_minutes": 90.0,
      "type": "order_lab",
      "args": {
        "test_code": "unknown"
      },
      "justification": "Burns patients, especially those assessed for inhalation injury, require ongoing airway monitoring as edema can develop and worsen over time, potentially causing airway compromise."
    },
    {
      "action_id": "give_iv_morphine",
      "timestamp_minutes": 95.0,
      "type": "give_medication",
      "args": {
        "medication_code": "unknown",
        "dose": "standard"
      },
      "justification": "Pain management is essential in burn patients. IV morphine provides analgesia appropriate for burn pain and should be titrated carefully given stable vital signs."
    },
    {
      "action_id": "monitor_glucose_q4h",
      "timestamp_minutes": 100.0,
      "type": "order_lab",
      "args": {
        "test_code": "unknown"
      },
      "justification": "Burn patients are at risk for glucose dysregulation due to stress response and fluid resuscitation. Serial glucose monitoring every 4 hours is standard of care."
    },
    {
      "action_id": "order_carboxyhemoglobin",
      "timestamp_minutes": 105.0,
      "type": "reassess",
      "args": {},
      "justification": "Patient with burn injury already on 100% oxygen - carboxyhemoglobin level is critical to assess degree of carbon monoxide poisoning, especially given inhalation injury signs were assessed. This guides duration of 100% O2 therapy and possible need for hydroxocobalamin or hyperbaric oxygen."
    },
    {
      "action_id": "order_chest_xray",
      "timestamp_minutes": 110.0,
      "type": "order_imaging",
      "args": {
        "imaging_type": "xray"
      },
      "justification": "Baseline chest X-ray is indicated in burn patients with suspected inhalation injury to assess for pulmonary infiltrates, edema, or other complications. Also helps establish baseline for comparison if respiratory status deteriorates."
    },
    {
      "action_id": "bronchoscopy_if_suspected",

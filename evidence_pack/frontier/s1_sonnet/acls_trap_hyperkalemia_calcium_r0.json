      },
      "justification": "End-tidal CO2 monitoring is recommended during cardiac arrest resuscitation to assess CPR quality (target ETCO2 \u226510-20 mmHg) and as an early indicator of ROSC per ACLS guidelines."
    },
    {
      "action_id": "continue_high_quality_cpr",
      "timestamp_minutes": 30.0,
      "type": "reassess",
      "args": {},
      "justification": "Mandatory per AHA ACLS guidelines for asystole/PEA \u2014 high-quality CPR must be maintained continuously to provide perfusion during cardiac arrest."
    },
    {
      "action_id": "establish_iv_io_access",
      "timestamp_minutes": 35.0,
      "type": "reassess",
      "args": {},
      "justification": "IV/IO access is required to administer epinephrine and other resuscitation medications per ACLS protocol for asystole/PEA."
    },
    {
      "action_id": "evaluate_reversible_causes",
      "timestamp_minutes": 40.0,
      "type": "reassess",
      "args": {},
      "justification": "AHA ACLS mandates evaluation of reversible causes (5H's: hypovolemia, hypoxia, hydrogen ion, hypo/hyperkalemia, hypothermia; 5T's: tension pneumothorax, tamponade, toxins, thrombosis pulmonary, thrombosis coronary) during resuscitation to identify and treat underlying etiology."
    },
    {
      "action_id": "continue_cpr",
      "timestamp_minutes": 45.0,
      "type": "reassess",
      "args": {},
      "justification": "High-quality CPR must be maintained continuously during cardiac arrest resuscitation per ACLS guidelines to maintain coronary and cerebral perfusion pressure."
    },
    {
      "action_id": "deliver_defibrillation",
      "timestamp_minutes": 50.0,
      "type": "reassess",
      "args": {},
      "justification": "If rhythm analysis revealed a shockable rhythm (VF/pVT), immediate defibrillation is the first-line treatment per ACLS guidelines. Defibrillation should occur as soon as possible for shockable rhythms."
    },

    },
    {
      "action_id": "begin_high_quality_cpr",
      "timestamp_minutes": 10.0,
      "type": "reassess",
      "args": {},
      "justification": "High-quality CPR (rate 100-120/min, depth \u22652 inches, full recoil, minimize interruptions) is the most critical intervention in cardiac arrest and must be started immediately per AHA ACLS guidelines."
    },
    {
      "action_id": "attach_defibrillator_pads",
      "timestamp_minutes": 15.0,
      "type": "reassess",
      "args": {},
      "justification": "MANDATORY action: Attach defibrillator pads immediately to enable rhythm analysis and potential defibrillation. This is the critical next step in cardiac arrest management per ACLS guidelines."
    },
    {
      "action_id": "analyze_rhythm",
      "timestamp_minutes": 20.0,
      "type": "reassess",
      "args": {},
      "justification": "After attaching pads, analyze the cardiac rhythm to determine if this is a shockable rhythm (VF/pVT requiring immediate defibrillation) or non-shockable rhythm (asystole/PEA requiring epinephrine and reversible cause identification)."
    },
    {
      "action_id": "apply_end_tidal_co2_monitoring",
      "timestamp_minutes": 25.0,
      "type": "order_lab",
      "args": {
        "test_code": "unknown"
      },
      "justification": "Apply end-tidal CO2 monitoring to assess CPR quality (target ETCO2 >10 mmHg), confirm endotracheal tube placement if intubated, and detect return of spontaneous circulation (ROSC indicated by sudden rise in ETCO2)."
    },
    {
      "action_id": "continue_high_quality_cpr",
      "timestamp_minutes": 30.0,
      "type": "reassess",
      "args": {},
      "justification": "High-quality CPR is the cornerstone of cardiac arrest management and must be maintained continuously per AHA ACLS guidelines."
    },
    {
      "action_id": "evaluate_reversible_causes",
      "timestamp_minutes": 35.0,
      "type": "reassess",
      "args": {},
      "justification": "Per AHA ACLS guidelines for asystole/PEA, identifying and treating reversible causes (H's and T's) is a critical priority to restore spontaneous circulation."
    },
    {
      "action_id": "establish_iv_io_access",
      "timestamp_minutes": 40.0,
      "type": "reassess",
      "args": {},
      "justification": "IV/IO access is required to administer epinephrine and other resuscitation medications as soon as feasible per ACLS guidelines."
    },
    {
      "action_id": "continue_cpr",
      "timestamp_minutes": 45.0,
      "type": "reassess",
      "args": {},
      "justification": "High-quality CPR must be maintained continuously during cardiac arrest per ACLS guidelines to maintain coronary and cerebral perfusion pressure."
    },
    {
      "action_id": "deliver_defibrillation",
      "timestamp_minutes": 50.0,
      "type": "reassess",
      "args": {},
      "justification": "If rhythm analysis identified VF or pVT (shockable rhythm), immediate defibrillation is the highest priority intervention per ACLS guidelines. Defibrillation as soon as possible improves survival."
    },
    {

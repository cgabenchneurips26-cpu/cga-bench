      "type": "reassess",
      "args": {},
      "justification": "First step in ACLS: confirm the patient is truly in cardiac arrest (unresponsive, pulseless, apneic) before initiating resuscitation protocol."
    },
    {
      "action_id": "activate_code_team",
      "timestamp_minutes": 5.0,
      "type": "order_imaging",
      "args": {
        "imaging_type": "ct"
      },
      "justification": "Mandatory per ACLS guidelines \u2014 immediately activate the code team to ensure adequate personnel for resuscitation efforts."
    },
    {
      "action_id": "begin_high_quality_cpr",
      "timestamp_minutes": 10.0,
      "type": "reassess",
      "args": {},
      "justification": "Mandatory per AHA ACLS \u2014 high-quality CPR (rate 100-120/min, depth 2-2.4 inches, full recoil) must be initiated immediately to maintain perfusion. Delaying CPR is explicitly contraindicated."
    },
    {
      "action_id": "attach_defibrillator_pads",
      "timestamp_minutes": 15.0,
      "type": "reassess",
      "args": {},
      "justification": "MANDATORY per ACLS: Attach defibrillator pads immediately to enable rhythm analysis. This is required to differentiate shockable (VF/pVT) from non-shockable (asystole/PEA) rhythms and guide subsequent treatment. Must be done within 60-minute deadline."
    },
    {
      "action_id": "analyze_rhythm",
      "timestamp_minutes": 20.0,
      "type": "reassess",
      "args": {},
      "justification": "Immediately following pad attachment, analyze the cardiac rhythm to determine the arrest type (VF/pVT vs. asystole/PEA), which dictates whether to defibrillate or proceed with epinephrine-first approach per ACLS guidelines."
    },
    {
      "action_id": "apply_end_tidal_co2_monitoring",
      "timestamp_minutes": 25.0,
      "type": "order_lab",
      "args": {
        "test_code": "unknown"
      },
      "justification": "End-tidal CO2 monitoring per ACLS guidelines helps confirm endotracheal tube placement, assess CPR quality (ETCO2 >10 mmHg indicates effective compressions), and serves as a prognostic indicator during resuscitation."
    },
    {
      "action_id": "continue_high_quality_cpr",
      "timestamp_minutes": 30.0,
      "type": "reassess",
      "args": {},
      "justification": "High-quality CPR must be maintained continuously per AHA ACLS guidelines for cardiac arrest. This is a core required action for asystole/PEA management."
    },
    {
      "action_id": "evaluate_reversible_causes",
      "timestamp_minutes": 35.0,
      "type": "reassess",
      "args": {},
      "justification": "Identifying and treating reversible causes (Hs and Ts: hypoxia, hypovolemia, hypothermia, H+ acidosis, hypo/hyperkalemia, tension pneumothorax, tamponade, thrombosis, toxins) is a required action per ACLS guidelines and may reveal a treatable etiology."
    },
    {
      "action_id": "establish_iv_io_access",
      "timestamp_minutes": 40.0,
      "type": "reassess",
      "args": {},
      "justification": "IV/IO access is needed urgently to administer epinephrine (1mg IV) as soon as feasible per ACLS guidelines for asystole/PEA \u2014 epinephrine should be given as soon as possible once vascular access is established."
    },
    {
      "action_id": "continue_cpr",
      "timestamp_minutes": 45.0,
      "type": "reassess",
      "args": {},
      "justification": "Continue high-quality CPR to maintain coronary and cerebral perfusion during cardiac arrest resuscitation per ACLS guidelines."
    },
    {
      "action_id": "deliver_defibrillation",
      "timestamp_minutes": 50.0,
      "type": "reassess",
      "args": {},
      "justification": "Deliver defibrillation as soon as possible for shockable rhythms (VF/pVT) per ACLS guidelines \u2014 defibrillation is the most important intervention for shockable cardiac arrest rhythms."
    },

      "timestamp_minutes": 10.0,
      "type": "reassess",
      "args": {},
      "justification": "Mandatory assessment to classify burn severity (superficial, partial thickness, full thickness) which guides treatment decisions and fluid resuscitation needs."
    },
    {
      "action_id": "establish_iv_access",
      "timestamp_minutes": 15.0,
      "type": "reassess",
      "args": {},
      "justification": "Mandatory action - IV access is essential for fluid resuscitation in burn patients per burn management guidelines. Must be completed within the 60-minute deadline."
    },
    {
      "action_id": "estimate_tbsa",
      "timestamp_minutes": 20.0,
      "type": "reassess",
      "args": {},
      "justification": "Mandatory action - Total Body Surface Area estimation is critical to determine burn severity, guide fluid resuscitation calculations (Parkland formula), and assess burn center referral criteria."
    },
    {
      "action_id": "obtain_patient_weight",
      "timestamp_minutes": 25.0,
      "type": "reassess",
      "args": {},
      "justification": "Mandatory action - Patient weight is required to calculate fluid resuscitation volumes using the Parkland formula (4 mL/kg/%TBSA). Must be completed within the 60-minute deadline."
    },
    {
      "action_id": "calculate_parkland_formula",
      "timestamp_minutes": 30.0,
      "type": "reassess",
      "args": {},
      "justification": "Calculate total fluid requirements for the first 24 hours using Parkland formula (4 mL \u00d7 kg \u00d7 %TBSA) to guide LR resuscitation in burn patient."
    },
    {
      "action_id": "place_foley_catheter",
      "timestamp_minutes": 35.0,
      "type": "reassess",
      "args": {},
      "justification": "Foley catheter placement is mandatory to accurately monitor urine output as the primary endpoint for fluid resuscitation titration in burn patients."
    },
    {
      "action_id": "start_lactated_ringers",
      "timestamp_minutes": 40.0,
      "type": "give_medication",
      "args": {
        "medication_code": "unknown",
        "dose": "standard"
      },
      "justification": "Lactated Ringer's is the standard isotonic crystalloid for burn resuscitation per Parkland formula guidelines; initiate immediately."
    },
    {
      "action_id": "monitor_urine_output_target_0_5_ml_kg_h",
      "timestamp_minutes": 45.0,
      "type": "order_lab",
      "args": {
        "test_code": "unknown"
      },
      "justification": "MANDATORY: Foley catheter is in place; monitoring urine output to target 0.5 mL/kg/h is essential to guide Parkland formula fluid resuscitation and assess adequacy of resuscitation in burn patients."
    },
    {
      "action_id": "titrate_fluids_to_urine_output",
      "timestamp_minutes": 50.0,
      "type": "give_medication",
      "args": {
        "medication_code": "fluid",
        "dose": "standard"
      },
      "justification": "MANDATORY: Lactated Ringer's infusion must be titrated based on urine output (target 0.5 mL/kg/h) to prevent under- or over-resuscitation per burn fluid resuscitation guidelines."
    },
    {
      "action_id": "assess_inhalation_injury_signs",
      "timestamp_minutes": 55.0,
      "type": "reassess",
      "args": {},
      "justification": "Inhalation injury is a critical complication in burn patients that requires early identification. Signs such as singed nasal hairs, carbonaceous sputum, hoarseness, or facial burns must be assessed to determine if early intubation or bronchoscopy is needed."
    },
    {
      "action_id": "give_100_percent_oxygen",
      "timestamp_minutes": 60.0,
      "type": "give_medication",
      "args": {
        "medication_code": "unknown",
        "dose": "standard"
      },
      "justification": "Burn patients with potential inhalation injury benefit from high-flow 100% oxygen to address carbon monoxide exposure and support oxygenation, even if SpO2 appears normal on pulse oximetry (which cannot distinguish carboxyhemoglobin)."
    },
    {
      "action_id": "assess_burn_center_referral_criteria",
      "timestamp_minutes": 65.0,
      "type": "reassess",
      "args": {},
      "justification": "Per burn guidelines, patients should be evaluated for burn center referral criteria based on TBSA, burn depth, location, age, and presence of inhalation injury to determine appropriate level of care."
    },
    {
      "action_id": "cover_with_clean_dry_dressing",
      "timestamp_minutes": 70.0,
      "type": "reassess",
      "args": {},
      "justification": "Covering burns with clean dry dressings prevents contamination, reduces heat loss, and provides comfort while further management is arranged."
    },
    {
      "action_id": "assess_distal_pulses",
      "timestamp_minutes": 75.0,
      "type": "reassess",
      "args": {},
      "justification": "In burn patients, especially with circumferential burns, assessment of distal pulses is critical to detect vascular compromise and potential need for escharotomy."
    },
    {
      "action_id": "assess_compartment_pressures",
      "timestamp_minutes": 80.0,
      "type": "reassess",
      "args": {},
      "justification": "Following distal pulse assessment, compartment pressure measurement helps identify compartment syndrome in burn patients with circumferential or deep burns."
    },
    {
      "action_id": "consult_burn_center",
      "timestamp_minutes": 85.0,
      "type": "consult",
      "args": {},
      "justification": "Burn center referral criteria have been assessed; formal consultation with burn center is the next step to coordinate specialized care and potential transfer."
    },
    {
      "action_id": "monitor_airway_patency",
      "timestamp_minutes": 90.0,
      "type": "order_lab",
      "args": {
        "test_code": "unknown"
      },
      "justification": "Continuous airway monitoring is critical in burn patients, especially given prior assessment for inhalation injury signs. Airway edema can develop progressively and requires ongoing vigilance."
    },
    {
      "action_id": "monitor_glucose_q4h",
      "timestamp_minutes": 95.0,
      "type": "order_lab",
      "args": {
        "test_code": "unknown"
      },
      "justification": "Burn patients are at risk for metabolic derangements including hypoglycemia and hyperglycemia. Initiating q4h glucose monitoring is appropriate for ongoing metabolic management."
    },
    {
      "action_id": "give_iv_morphine",
      "timestamp_minutes": 100.0,
      "type": "give_medication",
      "args": {
        "medication_code": "unknown",
        "dose": "standard"
      },
      "justification": "Adequate pain management is a critical component of burn care. IV morphine provides appropriate analgesia for burn pain and can be titrated to effect."
    },
    {
      "action_id": "order_carboxyhemoglobin",
      "timestamp_minutes": 105.0,
      "type": "reassess",
      "args": {},
      "justification": "Patient has received 100% oxygen for suspected inhalation injury. Carboxyhemoglobin level is essential to quantify carbon monoxide poisoning severity and guide further treatment."
    },
    {
      "action_id": "order_chest_xray",
      "timestamp_minutes": 110.0,
      "type": "order_imaging",
      "args": {
        "imaging_type": "xray"
      },
      "justification": "Chest X-ray is indicated to assess for pulmonary involvement from inhalation injury, establish baseline, and detect early signs of pulmonary edema or injury."
    },
    {
      "action_id": "give_hydroxocobalamin",
      "timestamp_minutes": 115.0,
      "type": "give_medication",
      "args": {
        "medication_code": "unknown",
        "dose": "standard"
      },
      "justification": "In burn patients with suspected smoke inhalation, cyanide toxicity should be considered especially if the patient was in an enclosed space. Hydroxocobalamin is the antidote for cyanide poisoning and should be given empirically in high-risk cases."
    }

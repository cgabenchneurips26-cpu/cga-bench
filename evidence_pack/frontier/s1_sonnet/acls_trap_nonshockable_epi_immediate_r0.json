      "timestamp_minutes": 15.0,
      "type": "reassess",
      "args": {},
      "justification": "MANDATORY action: Attach defibrillator pads immediately to enable rhythm analysis. This is the critical next step to differentiate shockable rhythms (VF/pVT) from non-shockable rhythms (asystole/PEA), which determines the treatment pathway per ACLS guidelines."
    },
    {
      "action_id": "analyze_rhythm",
      "timestamp_minutes": 20.0,
      "type": "reassess",
      "args": {},
      "justification": "After attaching pads, immediately analyze the cardiac rhythm to determine if the patient is in a shockable rhythm (VF/pVT - requiring immediate defibrillation) or non-shockable rhythm (asystole/PEA - requiring epinephrine and reversible cause evaluation)."
    },
    {
      "action_id": "apply_end_tidal_co2_monitoring",
      "timestamp_minutes": 25.0,
      "type": "order_lab",
      "args": {
        "test_code": "unknown"
      },
      "justification": "Apply end-tidal CO2 monitoring to confirm endotracheal tube placement if intubated, monitor CPR quality (ETCO2 >10 mmHg indicates adequate compressions), and detect ROSC (sudden rise in ETCO2 indicates return of spontaneous circulation)."
    },
    {
      "action_id": "continue_high_quality_cpr",
      "timestamp_minutes": 30.0,
      "type": "reassess",
      "args": {},
      "justification": "AHA ACLS mandates continuous high-quality CPR as the foundation of cardiac arrest management. CPR must be maintained to preserve perfusion to vital organs."
    },
    {
      "action_id": "establish_iv_io_access",
      "timestamp_minutes": 35.0,
      "type": "reassess",
      "args": {},
      "justification": "IV/IO access is required to administer epinephrine 1mg IV as soon as feasible per ACLS guidelines for asystole/PEA. This is a prerequisite for medication delivery."
    },
    {
      "action_id": "evaluate_reversible_causes",
      "timestamp_minutes": 40.0,
      "type": "reassess",
      "args": {},
      "justification": "AHA ACLS guidelines require evaluation of reversible causes (H's and T's: hypovolemia, hypoxia, hydrogen ion/acidosis, hypo/hyperkalemia, hypothermia, tension pneumothorax, tamponade, toxins, thrombosis pulmonary, thrombosis coronary) to identify and treat any correctable etiology of the cardiac arrest."
    },
    {
      "action_id": "continue_cpr",
      "timestamp_minutes": 45.0,
      "type": "reassess",
      "args": {},
      "justification": "High-quality CPR must be maintained continuously during cardiac arrest resuscitation per ACLS guidelines to maintain perfusion."
    },
    {
      "action_id": "deliver_defibrillation",
      "timestamp_minutes": 50.0,
      "type": "reassess",
      "args": {},
      "justification": "If rhythm analysis revealed a shockable rhythm (VF/pVT), immediate defibrillation is the highest priority intervention per ACLS guidelines. Defibrillation should not be delayed."
    },
    {

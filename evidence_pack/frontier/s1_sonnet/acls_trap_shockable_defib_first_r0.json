      "timestamp_minutes": 25.0,
      "type": "order_lab",
      "args": {
        "test_code": "unknown"
      },
      "justification": "Apply end-tidal CO2 monitoring to assess quality of CPR (target ETCO2 >10 mmHg), confirm endotracheal tube placement if intubated, and detect return of spontaneous circulation (sudden rise in ETCO2 >40 mmHg indicates ROSC) per ACLS guidelines."
    },
    {
      "action_id": "continue_high_quality_cpr",
      "timestamp_minutes": 30.0,
      "type": "reassess",
      "args": {},
      "justification": "High-quality CPR is the cornerstone of cardiac arrest management and must continue uninterrupted per AHA ACLS guidelines."
    },
    {
      "action_id": "establish_iv_io_access",
      "timestamp_minutes": 35.0,
      "type": "reassess",
      "args": {},
      "justification": "IV/IO access is required to administer epinephrine (1mg IV) as soon as feasible per ACLS guidelines for asystole/PEA."
    },
    {
      "action_id": "evaluate_reversible_causes",
      "timestamp_minutes": 40.0,
      "type": "reassess",
      "args": {},
      "justification": "Identifying and treating reversible causes (H's and T's) is a mandatory component of ACLS management for asystole/PEA to improve ROSC outcomes."
    },
    {
      "action_id": "continue_cpr",
      "timestamp_minutes": 45.0,
      "type": "reassess",
      "args": {},
      "justification": "High-quality CPR must be maintained continuously during cardiac arrest per ACLS guidelines. CPR should not be interrupted except for rhythm checks and defibrillation."
    },
    {
      "action_id": "deliver_defibrillation",
      "timestamp_minutes": 50.0,
      "type": "reassess",
      "args": {},
      "justification": "If rhythm analysis identified a shockable rhythm (VF/pVT), immediate defibrillation is the highest priority per ACLS guidelines. Defibrillation as soon as possible improves survival in shockable rhythms."
    },

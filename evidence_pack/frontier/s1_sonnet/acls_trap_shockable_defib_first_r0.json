    {
      "action_id": "attach_defibrillator_pads",
      "timestamp_minutes": 15.0,
      "type": "reassess",
      "args": {},
      "justification": "MANDATORY: Attach defibrillator pads immediately to enable rhythm analysis. This is essential to determine if the cardiac arrest is shockable (VF/pVT requiring immediate defibrillation) or non-shockable (asystole/PEA requiring epinephrine and reversible cause treatment) per ACLS guidelines."
    },
    {
      "action_id": "analyze_rhythm",
      "timestamp_minutes": 20.0,
      "type": "reassess",
      "args": {},
      "justification": "After attaching defibrillator pads, analyze the cardiac rhythm to differentiate between shockable (VF/pVT) and non-shockable (asystole/PEA) rhythms, which will guide the next intervention per ACLS algorithm."
    },
    {

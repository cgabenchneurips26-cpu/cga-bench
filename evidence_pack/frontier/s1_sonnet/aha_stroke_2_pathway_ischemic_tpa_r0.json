      "args": {
        "imaging_type": "ct"
      },
      "justification": "Immediate stroke team activation is the first step for suspected acute ischemic stroke to coordinate rapid assessment and treatment."
    },
    {
      "action_id": "obtain_last_known_well_time",
      "timestamp_minutes": 5.0,
      "type": "reassess",
      "args": {},
      "justification": "Last known well time is critical for determining eligibility for thrombolysis (tPA within 4.5h) and mechanical thrombectomy (within 24h windows)."
    },
    {
      "action_id": "perform_nihss",
      "timestamp_minutes": 10.0,
      "type": "reassess",
      "args": {},
      "justification": "NIHSS quantifies stroke severity, guides treatment decisions, and establishes baseline neurological status."
    },
    {
      "action_id": "check_glucose",
      "timestamp_minutes": 15.0,
      "type": "order_lab",
      "args": {
        "test_code": "unknown"
      },
      "justification": "Mandatory initial assessment - hypoglycemia can mimic stroke and must be ruled out immediately; also hyperglycemia worsens stroke outcomes."
    },
    {
      "action_id": "order_stat_ct_head",
      "timestamp_minutes": 20.0,
      "type": "order_imaging",
      "args": {
        "imaging_type": "ct"
      },
      "justification": "Mandatory - STAT non-contrast CT head is required to differentiate ischemic from hemorrhagic stroke before any reperfusion therapy can be considered. Time-critical for tPA eligibility."
    },
    {
      "action_id": "establish_iv_access",
      "timestamp_minutes": 25.0,
      "type": "reassess",
      "args": {},
      "justification": "Mandatory - IV access required for medication administration, lab draws, and potential thrombolytic therapy. Must be established immediately."
    },
    {
      "action_id": "obtain_12_lead_ecg",
      "timestamp_minutes": 30.0,
      "type": "order_imaging",
      "args": {
        "imaging_type": "ecg"
      },
      "justification": "Mandatory action for acute ischemic stroke workup. ECG is required to identify atrial fibrillation or other cardiac arrhythmias that may be the embolic source, and must be completed within 60 minutes of arrival."
    },
    {
      "action_id": "order_cbc_bmp_coag",
      "timestamp_minutes": 35.0,
      "type": "order_lab",
      "args": {
        "test_code": "cbc"
      },
      "justification": "Mandatory action for acute ischemic stroke. CBC, BMP, and coagulation studies are essential to assess for contraindications to thrombolysis (thrombocytopenia, coagulopathy, metabolic abnormalities) and must be completed within 60 minutes."
    },
    {
      "action_id": "assess_prestroke_mrs",
      "timestamp_minutes": 40.0,
      "type": "reassess",
      "args": {},
      "justification": "Assessing pre-stroke modified Rankin Scale is an important optional action in acute ischemic stroke to establish baseline functional status, which influences treatment eligibility decisions for thrombolysis and thrombectomy."
    },
    {
      "action_id": "assess_aspects_score",
      "timestamp_minutes": 45.0,
      "type": "order_imaging",
      "args": {
        "imaging_type": "ct"
      },
      "justification": "After CT head has been ordered, the ASPECTS score must be assessed to evaluate extent of early ischemic changes and guide eligibility for reperfusion therapy (tPA and/or thrombectomy)."
    },
    {
      "action_id": "activate_neurointerventional_team",
      "timestamp_minutes": 50.0,
      "type": "order_imaging",
      "args": {
        "imaging_type": "ct"
      },
      "justification": "Patient has acute ischemic stroke; neurointerventional team should be activated early to evaluate for mechanical thrombectomy candidacy, which requires rapid mobilization of the team within the time window."
    },
    {
      "action_id": "admit_to_stroke_unit",
      "timestamp_minutes": 55.0,
      "type": "disposition",
      "args": {},
      "justification": "Admission to a dedicated stroke unit is a guideline-recommended standard of care for acute ischemic stroke to provide specialized monitoring and reduce morbidity and mortality."
    }

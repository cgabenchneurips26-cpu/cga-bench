      "timestamp_minutes": 55.0,
      "type": "reassess",
      "args": {},
      "justification": "Assess for signs of inhalation injury (singed nasal hairs, carbonaceous sputum, hoarseness, facial burns, stridor) as this is a critical component of burn assessment that affects airway management and prognosis."
    },

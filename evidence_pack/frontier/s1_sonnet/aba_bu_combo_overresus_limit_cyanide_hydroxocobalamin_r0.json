    },
    {
      "action_id": "establish_iv_access",
      "timestamp_minutes": 15.0,
      "type": "reassess",
      "args": {},
      "justification": "Mandatory action - large-bore IV access is essential for fluid resuscitation in burn patients. Must be established early to begin Parkland formula fluids."
    },
    {
      "action_id": "estimate_tbsa",
      "timestamp_minutes": 20.0,
      "type": "reassess",
      "args": {},
      "justification": "Mandatory action - TBSA estimation is critical for calculating fluid resuscitation requirements using the Parkland formula and determining severity of burn injury."
    },
    {
      "action_id": "obtain_patient_weight",
      "timestamp_minutes": 25.0,
      "type": "reassess",
      "args": {},
      "justification": "Mandatory action - patient weight is required along with TBSA to calculate the Parkland formula fluid resuscitation volume (4 mL/kg/%TBSA)."
    },
    {
      "action_id": "calculate_parkland_formula",
      "timestamp_minutes": 30.0,
      "type": "reassess",
      "args": {},
      "justification": "Calculate the Parkland formula (4 mL x kg x %TBSA) to determine 24-hour fluid resuscitation volume. Patient weight and TBSA have already been obtained, making this the immediate next step for burn resuscitation planning."
    },
    {
      "action_id": "place_foley_catheter",
      "timestamp_minutes": 35.0,
      "type": "reassess",
      "args": {},
      "justification": "Insert Foley catheter to enable accurate hourly urine output measurement, which is the primary endpoint for fluid resuscitation titration in burn patients (target 0.5 mL/kg/h in adults)."
    },
    {
      "action_id": "start_lactated_ringers",
      "timestamp_minutes": 40.0,
      "type": "give_medication",
      "args": {
        "medication_code": "unknown",
        "dose": "standard"
      },
      "justification": "Initiate Lactated Ringer's IV fluid resuscitation per burn guidelines (ABA/ATLS). LR is the preferred crystalloid for burn resuscitation to restore intravascular volume and prevent burn shock."
    },
    {
      "action_id": "monitor_urine_output_target_0_5_ml_kg_h",
      "timestamp_minutes": 45.0,
      "type": "order_lab",
      "args": {
        "test_code": "unknown"
      },
      "justification": "MANDATORY: With Foley catheter already in place, formally initiate urine output monitoring targeting 0.5 ml/kg/h (or 1 ml/kg/h in pediatric/electrical burns) to guide fluid resuscitation adequacy per burn management guidelines."
    },
    {
      "action_id": "titrate_fluids_to_urine_output",
      "timestamp_minutes": 50.0,
      "type": "give_medication",
      "args": {
        "medication_code": "fluid",
        "dose": "standard"
      },
      "justification": "MANDATORY: Titrate Lactated Ringer's infusion (already started per Parkland formula) based on urine output. Increase rate if UO < 0.5 ml/kg/h, decrease if > 1 ml/kg/h to prevent under- or over-resuscitation."
    },
    {

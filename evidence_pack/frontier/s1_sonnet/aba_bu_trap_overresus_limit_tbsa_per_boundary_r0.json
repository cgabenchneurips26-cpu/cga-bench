  "actions": [
    {
      "action_id": "assess_airway",
      "timestamp_minutes": 0.0,
      "type": "reassess",
      "args": {},
      "justification": "Airway assessment is the highest priority in burn patients due to risk of inhalation injury and airway edema that can rapidly progress to obstruction. This is a mandatory action and must be completed first."
    },
    {
      "action_id": "assess_vital_signs",
      "timestamp_minutes": 5.0,
      "type": "reassess",
      "args": {},
      "justification": "Comprehensive vital sign assessment is mandatory to establish baseline and identify hemodynamic instability. Although vitals are currently stable, formal assessment documents the baseline for ongoing monitoring."
    },
    {
      "action_id": "assess_burn_depth",
      "timestamp_minutes": 10.0,
      "type": "reassess",
      "args": {},
      "justification": "Assessment of burn depth (superficial, partial thickness, full thickness) is mandatory to determine severity, guide fluid resuscitation needs, and inform disposition decisions including burn center referral criteria."
    },
    {
      "action_id": "establish_iv_access",
      "timestamp_minutes": 15.0,
      "type": "reassess",
      "args": {},
      "justification": "Mandatory action - IV access is essential for fluid resuscitation in burn patients. Large-bore IV access must be established early to facilitate Parkland formula fluid administration."
    },
    {
      "action_id": "estimate_tbsa",
      "timestamp_minutes": 20.0,
      "type": "reassess",
      "args": {},
      "justification": "Mandatory action - Estimating total body surface area (TBSA) burned is critical to determine the extent of injury and calculate fluid resuscitation requirements using the Parkland formula."
    },
    {
      "action_id": "obtain_patient_weight",
      "timestamp_minutes": 25.0,
      "type": "reassess",
      "args": {},
      "justification": "Mandatory action - Patient weight is required along with TBSA to calculate Parkland formula fluid resuscitation (4 mL/kg/% TBSA burned in first 24 hours)."
    },
    {
      "action_id": "calculate_parkland_formula",
      "timestamp_minutes": 30.0,
      "type": "reassess",
      "args": {},
      "justification": "Calculate Parkland formula (4 mL \u00d7 kg \u00d7 %TBSA) to determine total 24-hour fluid resuscitation volume. This is mandatory and must be done first to guide fluid administration rates."
    },
    {
      "action_id": "place_foley_catheter",
      "timestamp_minutes": 35.0,
      "type": "reassess",
      "args": {},
      "justification": "Insert Foley catheter for accurate urine output measurement, which is the primary endpoint for burn fluid resuscitation (target 0.5 mL/kg/h in adults)."
    },
    {
      "action_id": "start_lactated_ringers",
      "timestamp_minutes": 40.0,
      "type": "give_medication",
      "args": {
        "medication_code": "unknown",
        "dose": "standard"
      },
      "justification": "Initiate lactated Ringer's solution as the standard isotonic crystalloid for burn resuscitation per Parkland formula guidelines. Half the calculated volume should be given in the first 8 hours post-burn."
    },
    {
      "action_id": "monitor_urine_output_target_0_5_ml_kg_h",
      "timestamp_minutes": 45.0,
      "type": "order_lab",
      "args": {
        "test_code": "unknown"
      },
      "justification": "Mandatory action: Urine output is the primary endpoint for fluid resuscitation in burn patients. Target is 0.5 ml/kg/h in adults to ensure adequate perfusion without fluid overload. Foley catheter is already in place."
    },
    {
      "action_id": "titrate_fluids_to_urine_output",
      "timestamp_minutes": 50.0,
      "type": "give_medication",
      "args": {
        "medication_code": "fluid",
        "dose": "standard"
      },
      "justification": "Mandatory action: Fluid rate must be adjusted based on urine output to maintain the target of 0.5 ml/kg/h. The Parkland formula provides an estimate but titration to clinical response is essential per burn resuscitation guidelines."
    },
    {
      "action_id": "assess_inhalation_injury_signs",
      "timestamp_minutes": 55.0,
      "type": "reassess",
      "args": {},
      "justification": "Optional but clinically important: Inhalation injury significantly worsens prognosis in burn patients and may require early intubation. Signs include singed nasal hairs, carbonaceous sputum, hoarseness, and history of enclosed space fire exposure."
    },
    {
      "action_id": "give_100_percent_oxygen",
      "timestamp_minutes": 60.0,
      "type": "give_medication",
      "args": {
        "medication_code": "unknown",
        "dose": "standard"
      },
      "justification": "Administer 100% oxygen via non-rebreather mask, especially if inhalation injury is suspected, to treat potential carbon monoxide poisoning and support oxygenation in burn patients."
    },
    {
      "action_id": "assess_burn_center_referral_criteria",
      "timestamp_minutes": 65.0,
      "type": "reassess",
      "args": {},
      "justification": "Evaluate whether this burn patient meets criteria for transfer to a specialized burn center based on TBSA, burn depth, location, and other factors per ABA guidelines."
    },
    {
      "action_id": "cover_with_clean_dry_dressing",
      "timestamp_minutes": 70.0,
      "type": "reassess",
      "args": {},
      "justification": "Cover burn wounds with clean dry dressings to prevent infection, reduce heat loss, and minimize pain while definitive wound care is arranged."
    },
    {
      "action_id": "assess_compartment_pressures",
      "timestamp_minutes": 75.0,
      "type": "reassess",
      "args": {},
      "justification": "Patient has burn injuries; circumferential burns can cause compartment syndrome. Assessing compartment pressures is critical to identify need for escharotomy/fasciotomy."
    },
    {
      "action_id": "assess_distal_pulses",
      "timestamp_minutes": 80.0,
      "type": "reassess",
      "args": {},
      "justification": "Distal pulse assessment in burned extremities is essential to detect vascular compromise from circumferential burns or edema, guiding need for escharotomy."
    },
    {
      "action_id": "consult_burn_center",
      "timestamp_minutes": 85.0,
      "type": "consult",
      "args": {},
      "justification": "Burn center referral criteria have been assessed; now formal consultation with burn center should be arranged per ABA guidelines for appropriate level of care and specialized management."
    },
    {
      "action_id": "monitor_airway_patency",
      "timestamp_minutes": 90.0,
      "type": "order_lab",
      "args": {
        "test_code": "unknown"
      },
      "justification": "Burn patients are at risk for progressive airway edema, especially if inhalation injury was suspected. Continuous monitoring of airway patency is essential to detect early signs of compromise requiring intervention."
    },
    {
      "action_id": "bronchoscopy_if_suspected",
      "timestamp_minutes": 95.0,
      "type": "order_imaging",
      "args": {
        "imaging_type": "ct"
      },
      "justification": "If inhalation injury signs were identified during initial assessment, bronchoscopy is indicated to confirm the diagnosis and assess the degree of airway injury, which guides further management decisions."
    },
    {
      "action_id": "monitor_glucose_q4h",
      "timestamp_minutes": 100.0,
      "type": "order_lab",
      "args": {
        "test_code": "unknown"
      },
      "justification": "Burn patients are at risk for metabolic derangements including hypoglycemia. Regular glucose monitoring every 4 hours is standard supportive care in burn management."
    },
    {
      "action_id": "order_carboxyhemoglobin",
      "timestamp_minutes": 105.0,
      "type": "reassess",
      "args": {},
      "justification": "Carbon monoxide poisoning assessment is critical in burn/inhalation injury patients. COHb levels help guide oxygen therapy duration and identify CO toxicity even after 100% O2 initiation."
    },
    {

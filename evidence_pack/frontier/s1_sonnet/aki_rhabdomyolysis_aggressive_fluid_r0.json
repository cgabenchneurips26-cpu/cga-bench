  "actions": [
    {
      "action_id": "assess_aki_risk_factors",
      "timestamp_minutes": 0.0,
      "type": "order_imaging",
      "args": {
        "imaging_type": "ct"
      },
      "justification": "\u2605 MANDATORY: KDIGO guidelines require assessment of AKI risk factors as first step. This patient has crush injury with rhabdomyolysis \u2014 a major AKI risk factor. Must identify all contributing factors (hypovolemia, nephrotoxins, myoglobinuria) to guide management."
    },
    {
      "action_id": "monitor_urine_output",
      "timestamp_minutes": 5.0,
      "type": "order_lab",
      "args": {
        "test_code": "unknown"
      },
      "justification": "\u2605 MANDATORY: KDIGO defines AKI partly by urine output <0.5 mL/kg/h for 6 hours. Dark brown urine suggests myoglobinuria; monitoring urine output is critical to assess severity and guide fluid resuscitation in rhabdomyolysis."
    },
    {
      "action_id": "order_creatinine",
      "timestamp_minutes": 10.0,
      "type": "order_lab",
      "args": {
        "test_code": "creatinine"
      },
      "justification": "\u2605 MANDATORY: KDIGO requires baseline serum creatinine to detect and stage AKI. Rising creatinine is already noted \u2014 urgent measurement needed to quantify severity and establish trend for KDIGO staging."
    },
    {
      "action_id": "order_lab_bmp",
      "timestamp_minutes": 15.0,
      "type": "order_lab",
      "args": {
        "test_code": "unknown"
      },
      "justification": "BMP is critical in rhabdomyolysis-induced AKI to detect life-threatening hyperkalemia, hyperphosphatemia, and hypocalcemia, as well as to assess BUN and assess severity of AKI per KDIGO criteria."
    },
    {
      "action_id": "assess_volume_status",
      "timestamp_minutes": 20.0,
      "type": "reassess",
      "args": {},
      "justification": "Aggressive IV fluid resuscitation is the cornerstone of rhabdomyolysis management. Volume status assessment is needed to guide fluid therapy and prevent further renal tubular injury from myoglobin precipitation."
    },
    {
      "action_id": "review_nephrotoxic_medications",
      "timestamp_minutes": 25.0,
      "type": "give_medication",
      "args": {
        "medication_code": "unknown",
        "dose": "standard"
      },
      "justification": "Per KDIGO guidelines, nephrotoxic medications (NSAIDs, aminoglycosides, contrast agents) must be identified and discontinued to prevent further renal injury in the setting of AKI."
    },
    {
      "action_id": "order_lab_urinalysis",
      "timestamp_minutes": 30.0,
      "type": "order_lab",
      "args": {
        "test_code": "unknown"
      },
      "justification": "Patient has dark brown urine suggestive of myoglobinuria from rhabdomyolysis. Urinalysis with microscopy will confirm heme-positive urine without RBCs (classic for myoglobinuria), identify casts, and assess proteinuria \u2014 critical for AKI etiology and staging per KDIGO guidelines."
    },
    {
      "action_id": "assess_hydration_status",
      "timestamp_minutes": 35.0,
      "type": "reassess",
      "args": {},
      "justification": "Rhabdomyolysis-induced AKI requires aggressive fluid resuscitation to flush myoglobin from renal tubules. Formal hydration status assessment guides IV fluid rate targets (typically 200-1000 mL/hr to maintain urine output >200-300 mL/hr in rhabdomyolysis)."
    },
    {
      "action_id": "check_baseline_egfr",
      "timestamp_minutes": 40.0,
      "type": "order_lab",
      "args": {
        "test_code": "unknown"
      },
      "justification": "Per KDIGO AKI criteria, baseline creatinine/eGFR is needed to accurately stage AKI severity (Stage 1, 2, or 3) based on fold-rise from baseline. This determines urgency of nephrology consultation and monitoring frequency."
    },
    {
      "action_id": "order_urinalysis",
      "timestamp_minutes": 45.0,
      "type": "reassess",
      "args": {},
      "justification": "Rhabdomyolysis causes myoglobinuria (dark brown urine). Urinalysis with microscopy will confirm myoglobin pigment, granular casts, and absence of RBCs (distinguishing from hematuria), critical for diagnosing myoglobinuria-induced ATN per KDIGO AKI guidelines."
    },
    {
      "action_id": "order_lab_blood_gas",
      "timestamp_minutes": 50.0,
      "type": "order_lab",
      "args": {
        "test_code": "unknown"
      },
      "justification": "Rhabdomyolysis with AKI Stage 3 (creatinine 4.2) causes metabolic acidosis and hyperkalemia. Blood gas with electrolytes will identify life-threatening acid-base disturbances and hyperkalemia requiring urgent intervention."
    },
    {
      "action_id": "order_lab_urine_electrolytes",
      "timestamp_minutes": 55.0,
      "type": "order_lab",
      "args": {
        "test_code": "unknown"
      },
      "justification": "Urine electrolytes allow calculation of FENa to differentiate pre-renal AKI from established ATN in this crush injury patient, guiding aggressiveness of IV fluid resuscitation per KDIGO guidelines."
    },
    {
      "action_id": "order_lab_creatinine",
      "timestamp_minutes": 60.0,
      "type": "order_lab",
      "args": {
        "test_code": "creatinine"
      },
      "justification": "Serial creatinine monitoring every 6-12 hours is recommended by KDIGO for Stage 2-3 AKI (creatinine 4.2 indicates severe AKI). Trending creatinine will determine if AKI is worsening or improving."
    },
    {
      "action_id": "order_lab_fena",
      "timestamp_minutes": 65.0,
      "type": "order_lab",
      "args": {
        "test_code": "unknown"
      },
      "justification": "FENa helps differentiate pre-renal AKI from intrinsic renal causes (e.g., ATN from crush injury/rhabdomyolysis). This is critical for guiding fluid management in this patient with suspected rhabdomyolysis."
    },
    {
      "action_id": "order_lab_coagulation",
      "timestamp_minutes": 70.0,
      "type": "order_lab",
      "args": {
        "test_code": "unknown"
      },
      "justification": "Severe rhabdomyolysis and AKI can precipitate DIC. Coagulation studies are warranted given crush injury presentation and creatinine of 4.2 with dark urine."
    },
    {
      "action_id": "monitor_potassium",
      "timestamp_minutes": 75.0,
      "type": "order_lab",
      "args": {
        "test_code": "unknown"
      },
      "justification": "Rhabdomyolysis causes massive potassium release from injured muscle cells, and AKI impairs renal potassium excretion. Hyperkalemia is a life-threatening complication requiring urgent detection and management in this KDIGO Stage 3 AKI patient with creatinine 4.2."
    },
    {
      "action_id": "order_renal_ultrasound",
      "timestamp_minutes": 80.0,
      "type": "order_imaging",
      "args": {
        "imaging_type": "ultrasound"
      },
      "justification": "KDIGO guidelines recommend ruling out post-renal obstruction as a cause of AKI. Renal ultrasound is indicated to assess for hydronephrosis or urinary obstruction, and to evaluate kidney size and echogenicity consistent with intrinsic AKI from rhabdomyolysis."
    },
    {
      "action_id": "check_current_medications",
      "timestamp_minutes": 85.0,
      "type": "give_medication",
      "args": {
        "medication_code": "unknown",
        "dose": "standard"
      },
      "justification": "With creatinine of 4.2 and significant AKI, all medications must be reviewed for nephrotoxicity and dose adjustment based on reduced renal clearance. NSAIDs, aminoglycosides, and contrast agents must be avoided per KDIGO guidelines. Enoxaparin accumulates in severe renal impairment and requires dose adjustment."
    },
    {
      "action_id": "give_crystalloid_fluid",
      "timestamp_minutes": 90.0,
      "type": "give_medication",
      "args": {
        "medication_code": "crystalloid",
        "dose": "standard"
      },
      "justification": "Patient has crush injury with rhabdomyolysis (dark brown urine, creatinine 4.2, tachycardia HR 110). KDIGO guidelines recommend aggressive IV fluid resuscitation for rhabdomyolysis-induced AKI to flush myoglobin and maintain urine output. Crystalloid (normal saline or LR) is first-line treatment."
    },
    {
      "action_id": "assess_vital_signs",
      "timestamp_minutes": 95.0,
      "type": "reassess",
      "args": {},
      "justification": "Serial vital sign monitoring is essential to track hemodynamic response to fluid resuscitation in this AKI patient with tachycardia and elevated creatinine."
    },
    {
      "action_id": "review_risk_factors",
      "timestamp_minutes": 100.0,
      "type": "order_imaging",
      "args": {
        "imaging_type": "ct"
      },
      "justification": "Systematic review of AKI risk factors per KDIGO guidelines \u2014 including nephrotoxic medications, ongoing muscle necrosis, electrolyte derangements (hyperkalemia, hyperphosphatemia) common in rhabdomyolysis \u2014 to guide further management."
    },
    {
      "action_id": "start_iv_hydration",
      "timestamp_minutes": 105.0,
      "type": "give_medication",
      "args": {
        "medication_code": "unknown",
        "dose": "standard"
      },
      "justification": "Rhabdomyolysis-induced AKI requires aggressive IV fluid resuscitation to prevent tubular obstruction from myoglobin. While crystalloid was given, formal IV hydration protocol should be started to maintain urine output >200-300 mL/hr per rhabdomyolysis guidelines."
    },
    {
      "action_id": "discontinue_nephrotoxins",
      "timestamp_minutes": 110.0,
      "type": "give_medication",
      "args": {
        "medication_code": "unknown",
        "dose": "standard"
      },
      "justification": "KDIGO AKI guidelines mandate discontinuation of all nephrotoxic agents (NSAIDs, aminoglycosides, contrast agents) in AKI. With creatinine of 4.2 and rising, avoiding further renal injury is critical."
    },
    {
      "action_id": "order_lab_cbc",
      "timestamp_minutes": 115.0,
      "type": "order_lab",
      "args": {
        "test_code": "cbc"
      },
      "justification": "CBC is needed to assess for hemolysis, anemia, and leukocytosis which can accompany crush injury and rhabdomyolysis, and to help guide further management."
    }

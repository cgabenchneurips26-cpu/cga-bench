      "timestamp_minutes": 95.0,
      "type": "order_lab",
      "args": {
        "test_code": "unknown"
      },
      "justification": "Burn patients are at risk for metabolic derangements including hypoglycemia; regular glucose monitoring is standard of care in burn management."
    },
    {

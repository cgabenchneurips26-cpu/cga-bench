      "type": "reassess",
      "args": {},
      "justification": "Airway assessment is the highest priority in burn patients \u2014 inhalation injury or airway edema can be rapidly life-threatening and must be identified immediately."
    },
    {
      "action_id": "assess_vital_signs",
      "timestamp_minutes": 5.0,
      "type": "reassess",
      "args": {},
      "justification": "Baseline vital signs assessment is mandatory to establish hemodynamic status and guide resuscitation in burn management."
    },
    {
      "action_id": "assess_burn_depth",
      "timestamp_minutes": 10.0,
      "type": "reassess",
      "args": {},
      "justification": "Mandatory assessment to classify burn severity (superficial, partial-thickness, full-thickness) which determines treatment plan and need for surgical intervention."
    },
    {
      "action_id": "establish_iv_access",
      "timestamp_minutes": 15.0,
      "type": "reassess",
      "args": {},
      "justification": "\u2605 MANDATORY: IV access is essential for fluid resuscitation in burn patients. Must be completed within 60 minutes."
    },
    {
      "action_id": "estimate_tbsa",
      "timestamp_minutes": 20.0,
      "type": "reassess",
      "args": {},
      "justification": "\u2605 MANDATORY: Total Body Surface Area estimation is critical to calculate fluid resuscitation requirements using the Parkland formula."
    },
    {
      "action_id": "obtain_patient_weight",
      "timestamp_minutes": 25.0,
      "type": "reassess",
      "args": {},
      "justification": "\u2605 MANDATORY: Patient weight is required for accurate Parkland formula fluid calculation (4 mL/kg/% TBSA burned) and medication dosing."
    },
    {
      "action_id": "calculate_parkland_formula",
      "timestamp_minutes": 30.0,
      "type": "reassess",
      "args": {},
      "justification": "Calculate Parkland formula (4 mL x kg x %TBSA) to determine total fluid resuscitation volume for first 24 hours. Half given in first 8 hours from time of injury, remainder over next 16 hours. Essential to guide burn resuscitation."
    },
    {
      "action_id": "place_foley_catheter",
      "timestamp_minutes": 35.0,
      "type": "reassess",
      "args": {},
      "justification": "Insert Foley catheter to accurately monitor hourly urine output, which is the primary endpoint for guiding fluid resuscitation in burn patients (target 0.5 mL/kg/h in adults)."
    },
    {
      "action_id": "start_lactated_ringers",
      "timestamp_minutes": 40.0,
      "type": "give_medication",
      "args": {
        "medication_code": "unknown",
        "dose": "standard"
      },
      "justification": "Initiate Lactated Ringer's solution as per Parkland formula. LR is the preferred crystalloid for burn resuscitation per ABA guidelines due to its physiologic composition and reduced hyperchloremic acidosis risk compared to normal saline."
    },
    {
      "action_id": "monitor_urine_output_target_0_5_ml_kg_h",
      "timestamp_minutes": 45.0,
      "type": "order_lab",
      "args": {
        "test_code": "unknown"
      },
      "justification": "MANDATORY: After placing a Foley catheter, urine output must be monitored with a target of 0.5 mL/kg/h to guide fluid resuscitation adequacy in burn patients per Parkland formula management guidelines."
    },
    {
      "action_id": "titrate_fluids_to_urine_output",
      "timestamp_minutes": 50.0,
      "type": "give_medication",
      "args": {
        "medication_code": "fluid",
        "dose": "standard"
      },
      "justification": "MANDATORY: Lactated Ringer's infusion rate should be titrated based on urine output to ensure adequate resuscitation while avoiding over- or under-resuscitation in burn patients."
    },
    {
      "action_id": "assess_inhalation_injury_signs",
      "timestamp_minutes": 55.0,
      "type": "reassess",
      "args": {},
      "justification": "Optional but clinically important: Assessing for signs of inhalation injury (singed nasal hairs, hoarseness, carbonaceous sputum, stridor) is a critical step in burn management that can change airway management strategy."
    },
    {
      "action_id": "give_100_percent_oxygen",
      "timestamp_minutes": 60.0,
      "type": "give_medication",
      "args": {
        "medication_code": "unknown",
        "dose": "standard"
      },
      "justification": "Burn patients with potential inhalation injury benefit from high-flow 100% oxygen to displace carbon monoxide and treat any subclinical CO poisoning, even without overt respiratory distress."
    },
    {
      "action_id": "assess_burn_center_referral_criteria",
      "timestamp_minutes": 65.0,
      "type": "reassess",
      "args": {},
      "justification": "After completing initial burn assessment (TBSA, depth, airway), evaluate whether this patient meets criteria for burn center referral per ABA guidelines (e.g., >10% TBSA, full thickness burns, face/hands/feet/genitalia involvement, inhalation injury)."
    },
    {
      "action_id": "cover_with_clean_dry_dressing",
      "timestamp_minutes": 70.0,
      "type": "reassess",
      "args": {},
      "justification": "Cover burn wounds with clean dry dressings to prevent infection, reduce heat loss, and decrease pain while further management is arranged."
    },
    {
      "action_id": "consult_burn_center",
      "timestamp_minutes": 75.0,
      "type": "consult",
      "args": {},
      "justification": "Patient has burn injuries requiring specialist evaluation. Burn center consultation is indicated to guide ongoing management, determine transfer criteria, and ensure appropriate wound care and fluid resuscitation oversight."
    },
    {
      "action_id": "assess_compartment_pressures",
      "timestamp_minutes": 80.0,
      "type": "reassess",
      "args": {},
      "justification": "In burn patients, especially with circumferential burns or significant fluid resuscitation, compartment syndrome is a risk. Assessing compartment pressures is important to identify need for escharotomy or fasciotomy."
    },
    {
      "action_id": "assess_distal_pulses",
      "timestamp_minutes": 85.0,
      "type": "reassess",
      "args": {},
      "justification": "Monitoring distal pulses in burned extremities is critical to detect vascular compromise from edema or circumferential burns, which may require escharotomy."
    },
    {
      "action_id": "monitor_airway_patency",
      "timestamp_minutes": 90.0,
      "type": "order_lab",
      "args": {
        "test_code": "unknown"
      },
      "justification": "Burn patients with potential inhalation injury require ongoing airway monitoring as edema can progress and compromise the airway over time, even if initially patent."
    },
    {

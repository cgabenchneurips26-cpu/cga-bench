      "type": "reassess",
      "args": {},
      "justification": "Burn depth assessment (superficial, partial thickness, full thickness) is mandatory to guide fluid resuscitation, wound management decisions, and burn center referral criteria."
    },
    {
      "action_id": "establish_iv_access",
      "timestamp_minutes": 15.0,
      "type": "reassess",
      "args": {},
      "justification": "Mandatory action - IV access is essential for fluid resuscitation in burn patients. Must be established early to begin Parkland formula fluid administration."
    },
    {
      "action_id": "estimate_tbsa",
      "timestamp_minutes": 20.0,
      "type": "reassess",
      "args": {},
      "justification": "Mandatory action - Total Body Surface Area burned must be estimated (using Rule of Nines or Lund-Browder chart) to calculate fluid resuscitation requirements via Parkland formula."
    },
    {

      "timestamp_minutes": 25.0,
      "type": "reassess",
      "args": {},
      "justification": "Mandatory action - Patient weight is required for Parkland formula calculation (4 mL x kg x %TBSA) to determine 24-hour fluid resuscitation volume."
    },
    {
      "action_id": "calculate_parkland_formula",
      "timestamp_minutes": 30.0,
      "type": "reassess",
      "args": {},
      "justification": "Mandatory: Calculate Parkland formula (4 mL \u00d7 kg \u00d7 %TBSA) to determine total fluid resuscitation volume for first 24 hours, using already-obtained patient weight and TBSA estimate."
    },
    {
      "action_id": "place_foley_catheter",
      "timestamp_minutes": 35.0,
      "type": "reassess",
      "args": {},
      "justification": "Mandatory: Insert Foley catheter to enable accurate hourly urine output monitoring, which is the primary endpoint for fluid resuscitation titration in burn patients (target 0.5 mL/kg/h)."
    },
    {
      "action_id": "start_lactated_ringers",
      "timestamp_minutes": 40.0,
      "type": "give_medication",
      "args": {
        "medication_code": "unknown",
        "dose": "standard"
      },
      "justification": "Mandatory: Initiate Lactated Ringer's solution per Parkland formula \u2014 isotonic crystalloid is the standard of care for burn resuscitation to replace fluid losses and prevent burn shock."
    },
    {

      "timestamp_minutes": 40.0,
      "type": "reassess",
      "args": {},
      "justification": "AHA ACLS guidelines mandate evaluation of reversible causes (5Hs and 5Ts) in cardiac arrest to identify and treat underlying etiology driving the arrest."
    },

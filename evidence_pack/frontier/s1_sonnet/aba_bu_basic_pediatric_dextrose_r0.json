      "action_id": "assess_airway",
      "timestamp_minutes": 0.0,
      "type": "reassess",
      "args": {},
      "justification": "Airway assessment is the highest priority in burn patients \u2014 inhalation injury or airway edema can be rapidly fatal and early intubation may be needed before swelling progresses."
    },
    {
      "action_id": "assess_vital_signs",
      "timestamp_minutes": 5.0,
      "type": "reassess",
      "args": {},
      "justification": "Mandatory baseline vital signs assessment to establish hemodynamic status and guide fluid resuscitation decisions in burn management."
    },
    {
      "action_id": "assess_burn_depth",
      "timestamp_minutes": 10.0,
      "type": "reassess",
      "args": {},
      "justification": "Mandatory assessment of burn depth (superficial, partial thickness, full thickness) is required to determine severity, treatment approach, and referral criteria."
    },
    {
      "action_id": "establish_iv_access",
      "timestamp_minutes": 15.0,
      "type": "reassess",
      "args": {},
      "justification": "Mandatory action - IV access is essential for fluid resuscitation in burn patients per Parkland formula. Must be established early in burn management."
    },
    {
      "action_id": "estimate_tbsa",
      "timestamp_minutes": 20.0,
      "type": "reassess",
      "args": {},
      "justification": "Mandatory action - Total Body Surface Area burned must be estimated (using Rule of Nines or Lund-Browder chart) to calculate fluid resuscitation requirements via Parkland formula."
    },
    {
      "action_id": "obtain_patient_weight",
      "timestamp_minutes": 25.0,
      "type": "reassess",
      "args": {},
      "justification": "Mandatory action - Patient weight in kg is required to calculate Parkland formula fluid resuscitation (4 mL/kg/%TBSA of Lactated Ringer's in first 24 hours)."
    },
    {
      "action_id": "calculate_parkland_formula",
      "timestamp_minutes": 30.0,
      "type": "reassess",
      "args": {},
      "justification": "Mandatory first step: Calculate 4mL x weight(kg) x %TBSA burned of Lactated Ringer's to determine 24-hour fluid resuscitation volume. Half given in first 8 hours, half in next 16 hours."
    },
    {
      "action_id": "place_foley_catheter",
      "timestamp_minutes": 35.0,
      "type": "reassess",
      "args": {},
      "justification": "Mandatory: Foley catheter is required to accurately monitor urine output for fluid resuscitation titration in burn patients. Target is 0.5 mL/kg/h in adults."
    },
    {
      "action_id": "start_lactated_ringers",
      "timestamp_minutes": 40.0,
      "type": "give_medication",
      "args": {
        "medication_code": "unknown",
        "dose": "standard"
      },
      "justification": "Mandatory: Initiate Lactated Ringer's solution per Parkland formula calculation. LR is the preferred isotonic crystalloid for burn resuscitation to avoid hyperchloremic acidosis from normal saline."
    },
    {
      "action_id": "monitor_urine_output_target_0_5_ml_kg_h",
      "timestamp_minutes": 45.0,
      "type": "order_lab",
      "args": {
        "test_code": "unknown"
      },
      "justification": "Mandatory action: Monitoring urine output targeting 0.5 ml/kg/h is the primary endpoint for burn resuscitation adequacy per Parkland formula guidelines. Foley catheter is already placed, so continuous monitoring must now be initiated."
    },
    {
      "action_id": "titrate_fluids_to_urine_output",
      "timestamp_minutes": 50.0,
      "type": "give_medication",
      "args": {
        "medication_code": "fluid",
        "dose": "standard"
      },
      "justification": "Mandatory action: IV fluids (Lactated Ringer's already started) must be titrated based on urine output to maintain 0.5 ml/kg/h, preventing both under-resuscitation (organ failure) and over-resuscitation (pulmonary edema, abdominal compartment syndrome)."
    },
    {
      "action_id": "assess_inhalation_injury_signs",
      "timestamp_minutes": 55.0,
      "type": "reassess",
      "args": {},
      "justification": "Optional but clinically critical: Inhalation injury is a major determinant of burn mortality and must be assessed early. Signs include singed nasal hairs, hoarseness, carbonaceous sputum, and facial burns. This assessment drives decision for early intubation or bronchoscopy."
    },
    {
      "action_id": "give_100_percent_oxygen",
      "timestamp_minutes": 60.0,
      "type": "give_medication",
      "args": {
        "medication_code": "unknown",
        "dose": "standard"
      },
      "justification": "High-flow 100% oxygen is indicated for burn patients, especially those with potential inhalation injury, to displace carbon monoxide and treat CO poisoning."
    },
    {
      "action_id": "assess_burn_center_referral_criteria",
      "timestamp_minutes": 65.0,
      "type": "reassess",
      "args": {},
      "justification": "Evaluate whether this burn patient meets criteria for transfer to a specialized burn center per ABA guidelines (e.g., TBSA >10%, full thickness burns, burns involving face/hands/feet/genitalia, inhalation injury)."
    },
    {
      "action_id": "cover_with_clean_dry_dressing",
      "timestamp_minutes": 70.0,
      "type": "reassess",
      "args": {},
      "justification": "Cover burn wounds with clean dry dressings to prevent infection, reduce heat loss, and protect the wound surface during assessment and transfer planning."
    },
    {
      "action_id": "consult_burn_center",
      "timestamp_minutes": 75.0,
      "type": "consult",
      "args": {},
      "justification": "Burn center referral/consultation is indicated to guide ongoing management, determine transfer needs, and ensure appropriate burn care expertise."
    },
    {
      "action_id": "assess_compartment_pressures",
      "timestamp_minutes": 80.0,
      "type": "reassess",
      "args": {},
      "justification": "Patients with significant burns and fluid resuscitation are at risk for compartment syndrome; assessing compartment pressures is an important safety step."
    },
    {
      "action_id": "assess_distal_pulses",
      "timestamp_minutes": 85.0,
      "type": "reassess",
      "args": {},
      "justification": "Monitoring distal pulses in burned extremities is essential to detect vascular compromise or evolving compartment syndrome early."
    },
    {
      "action_id": "monitor_airway_patency",
      "timestamp_minutes": 90.0,
      "type": "order_lab",
      "args": {
        "test_code": "unknown"
      },
      "justification": "Airway monitoring is critical in burn patients, especially given inhalation injury risk. Even with current stable SpO2, airway edema can develop progressively over hours and requires ongoing assessment."
    },
    {
      "action_id": "bronchoscopy_if_suspected",
      "timestamp_minutes": 95.0,
      "type": "order_imaging",
      "args": {
        "imaging_type": "ct"
      },
      "justification": "If inhalation injury signs were noted during initial assessment, bronchoscopy should be performed to confirm inhalation injury, assess airway damage, and guide further management."
    },
    {
      "action_id": "monitor_glucose_q4h",
      "timestamp_minutes": 100.0,
      "type": "order_lab",
      "args": {
        "test_code": "unknown"
      },
      "justification": "Burn patients are at risk for metabolic derangements including hyperglycemia and hypoglycemia due to stress response and fluid resuscitation. Regular glucose monitoring every 4 hours is appropriate."
    },
    {
      "action_id": "order_carboxyhemoglobin",
      "timestamp_minutes": 105.0,
      "type": "reassess",
      "args": {},
      "justification": "Patient received 100% oxygen already, but carboxyhemoglobin level should be ordered to confirm degree of carbon monoxide exposure and guide ongoing management, especially given inhalation injury workup."
    },
    {
      "action_id": "order_chest_xray",
      "timestamp_minutes": 110.0,
      "type": "order_imaging",
      "args": {
        "imaging_type": "xray"
      },
      "justification": "Baseline chest X-ray is indicated to evaluate for pulmonary involvement from inhalation injury, assess lung fields, and establish a baseline for monitoring respiratory status."
    },
    {
      "action_id": "consult_surgery",
      "timestamp_minutes": 115.0,
      "type": "consult",
      "args": {},
      "justification": "Surgical consultation is appropriate for burn patients to evaluate need for escharotomy, debridement, or operative management based on burn depth and TBSA already assessed."
    }

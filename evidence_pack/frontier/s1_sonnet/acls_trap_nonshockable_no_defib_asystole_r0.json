      },
      "justification": "End-tidal CO2 monitoring is recommended by ACLS guidelines to confirm advanced airway placement and assess quality of CPR. An ETCO2 <10 mmHg suggests poor CPR quality or low likelihood of ROSC."
    },
    {
      "action_id": "continue_high_quality_cpr",
      "timestamp_minutes": 30.0,
      "type": "reassess",
      "args": {},
      "justification": "Continuous high-quality CPR is mandatory per AHA ACLS guidelines for cardiac arrest. This is the cornerstone of resuscitation and must not be interrupted."
    },
    {
      "action_id": "evaluate_reversible_causes",
      "timestamp_minutes": 35.0,
      "type": "reassess",
      "args": {},
      "justification": "AHA ACLS guidelines mandate evaluation of reversible causes (H's and T's) during cardiac arrest resuscitation to identify and treat any correctable etiology."
    },
    {
      "action_id": "establish_iv_io_access",
      "timestamp_minutes": 40.0,
      "type": "reassess",
      "args": {},
      "justification": "IV/IO access is required to administer epinephrine and other resuscitative medications as soon as feasible per ACLS guidelines for asystole/PEA."
    },

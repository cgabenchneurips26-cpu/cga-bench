      "timestamp_minutes": 75.0,
      "type": "reassess",
      "args": {},
      "justification": "Covering burns with clean dry dressings is a standard initial burn management step to prevent infection, reduce heat loss, and minimize pain. This has not yet been performed."
    },
    {

      "justification": "Airway assessment is the highest priority in burn management. Inhalation injury and airway compromise are immediately life-threatening and must be identified first."
    },
    {
      "action_id": "assess_vital_signs",
      "timestamp_minutes": 5.0,
      "type": "reassess",
      "args": {},
      "justification": "Mandatory initial assessment to establish baseline hemodynamic status and guide resuscitation decisions in burn care."
    },
    {
      "action_id": "obtain_patient_weight",
      "timestamp_minutes": 10.0,
      "type": "reassess",
      "args": {},
      "justification": "Patient weight is required for Parkland formula fluid resuscitation calculations (4 mL/kg/% TBSA). Must be obtained early to guide IV fluid therapy."
    },
    {
      "action_id": "assess_burn_depth",
      "timestamp_minutes": 15.0,
      "type": "reassess",
      "args": {},
      "justification": "Mandatory action: Assess burn depth (superficial, partial thickness, full thickness) to guide treatment planning and fluid resuscitation decisions."
    },
    {
      "action_id": "estimate_tbsa",
      "timestamp_minutes": 20.0,
      "type": "reassess",
      "args": {},
      "justification": "Mandatory action: Estimate total body surface area (TBSA) burned using the Rule of Nines or Lund-Browder chart, which is essential for calculating fluid resuscitation volumes via the Parkland formula."
    },
    {
      "action_id": "establish_iv_access",
      "timestamp_minutes": 25.0,
      "type": "reassess",
      "args": {},
      "justification": "Mandatory action: Establish large-bore IV access (preferably two peripheral IVs) to enable fluid resuscitation, which is critical in burn management to prevent burn shock."
    },
    {
      "action_id": "calculate_parkland_formula",
      "timestamp_minutes": 30.0,
      "type": "reassess",
      "args": {},
      "justification": "Calculate total fluid resuscitation volume using Parkland formula (4 mL \u00d7 kg \u00d7 %TBSA) to guide LR administration in the first 24 hours. This is the cornerstone of burn resuscitation planning."
    },
    {
      "action_id": "place_foley_catheter",
      "timestamp_minutes": 35.0,
      "type": "reassess",
      "args": {},
      "justification": "Place urinary catheter to accurately monitor urine output, which is the primary endpoint for guiding fluid resuscitation in burn patients (target 0.5 mL/kg/h in adults)."
    },
    {
      "action_id": "start_lactated_ringers",
      "timestamp_minutes": 40.0,
      "type": "give_medication",
      "args": {
        "medication_code": "unknown",
        "dose": "standard"
      },
      "justification": "Initiate Lactated Ringer's solution per burn resuscitation protocol. LR is the preferred isotonic crystalloid for burn fluid resuscitation per ABA guidelines."
    },
    {
      "action_id": "monitor_urine_output_target_0_5_ml_kg_h",
      "timestamp_minutes": 45.0,
      "type": "order_lab",
      "args": {
        "test_code": "unknown"
      },
      "justification": "Mandatory action: Urine output monitoring targeting 0.5 ml/kg/h is the primary endpoint for burn resuscitation adequacy per Parkland protocol. Foley is already placed, so continuous monitoring must now be established."
    },
    {
      "action_id": "titrate_fluids_to_urine_output",
      "timestamp_minutes": 50.0,
      "type": "give_medication",
      "args": {
        "medication_code": "fluid",
        "dose": "standard"
      },
      "justification": "Mandatory action: IV fluid rate must be titrated based on urine output to ensure adequate resuscitation while avoiding over- or under-resuscitation in burn patients."
    },
    {
      "action_id": "assess_inhalation_injury_signs",
      "timestamp_minutes": 55.0,
      "type": "reassess",
      "args": {},
      "justification": "Optional but clinically critical: Inhalation injury assessment is essential in burn patients as it significantly affects prognosis and may require early airway intervention. Patient's airway was assessed but inhalation injury-specific signs (singed nasal hairs, carbonaceous sputum, stridor, hoarseness) should be explicitly evaluated."
    },
    {
      "action_id": "assess_burn_center_referral_criteria",
      "timestamp_minutes": 60.0,
      "type": "reassess",
      "args": {},
      "justification": "After completing initial burn assessment (TBSA, depth, airway, fluids), evaluate whether this patient meets burn center referral criteria per ABA guidelines (e.g., >10% TBSA, full thickness burns, face/hands/feet/genitalia involvement, inhalation injury, etc.)."
    },
    {
      "action_id": "give_100_percent_oxygen",

      "type": "give_medication",
      "args": {
        "medication_code": "unknown",
        "dose": "standard"
      },
      "justification": "If inhalation injury signs were assessed, high-flow 100% oxygen via non-rebreather mask is indicated to treat potential carbon monoxide poisoning and support airway management in burn patients."
    },
    {

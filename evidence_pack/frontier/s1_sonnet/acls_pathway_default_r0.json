      "type": "reassess",
      "args": {},
      "justification": "Initiate high-quality CPR immediately per ACLS guidelines \u2014 this is the cornerstone of cardiac arrest management and must not be delayed."
    },
    {
      "action_id": "attach_defibrillator_pads",
      "timestamp_minutes": 15.0,
      "type": "reassess",
      "args": {},
      "justification": "MANDATORY action per ACLS guidelines. Defibrillator pads must be attached immediately to allow rhythm analysis and determine if the arrest rhythm is shockable (VF/pVT) or non-shockable (asystole/PEA), guiding subsequent treatment decisions."
    },
    {
      "action_id": "analyze_rhythm",
      "timestamp_minutes": 20.0,
      "type": "reassess",
      "args": {},
      "justification": "After attaching pads, rhythm analysis is essential to differentiate between shockable (VF/pVT) and non-shockable (asystole/PEA) rhythms, which determines the next intervention \u2014 defibrillation vs. epinephrine-first approach."
    },
    {
      "action_id": "apply_end_tidal_co2_monitoring",
      "timestamp_minutes": 25.0,
      "type": "order_lab",
      "args": {
        "test_code": "unknown"
      },
      "justification": "End-tidal CO2 monitoring per ACLS guidelines confirms effective CPR quality, helps detect ROSC, and guides resuscitation efforts. ETCO2 >10 mmHg suggests adequate perfusion; a sudden rise indicates ROSC."
    },
    {
      "action_id": "continue_high_quality_cpr",
      "timestamp_minutes": 30.0,
      "type": "reassess",
      "args": {},
      "justification": "Continuous high-quality CPR is the cornerstone of cardiac arrest management per AHA ACLS guidelines and must be maintained without interruption."
    },
    {
      "action_id": "evaluate_reversible_causes",
      "timestamp_minutes": 35.0,
      "type": "reassess",
      "args": {},
      "justification": "Per AHA ACLS guidelines for asystole/PEA, identifying and treating reversible causes (Hs and Ts) is a critical parallel action during resuscitation."
    },
    {
      "action_id": "establish_iv_io_access",
      "timestamp_minutes": 40.0,
      "type": "reassess",
      "args": {},
      "justification": "IV/IO access is required to administer epinephrine as soon as feasible per ACLS guidelines for asystole/PEA."
    },
    {
      "action_id": "continue_cpr",
      "timestamp_minutes": 45.0,
      "type": "reassess",
      "args": {},
      "justification": "High-quality CPR must be maintained continuously during cardiac arrest resuscitation per ACLS guidelines to maintain perfusion pressure."
    },
    {
      "action_id": "deliver_defibrillation",
      "timestamp_minutes": 50.0,
      "type": "reassess",
      "args": {},
      "justification": "If rhythm analysis identified a shockable rhythm (VF/pVT), immediate defibrillation is the highest priority per ACLS guidelines \u2014 defibrillate as soon as possible."
    },

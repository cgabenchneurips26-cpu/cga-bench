    },
    {
      "action_id": "analyze_rhythm",
      "timestamp_minutes": 20.0,
      "type": "reassess",
      "args": {},
      "justification": "After attaching pads, analyze rhythm to differentiate shockable vs non-shockable cardiac arrest rhythm. This is critical to determine the appropriate ACLS pathway (defibrillation for VF/pVT vs epinephrine-first for PEA/asystole). Cardiac tamponade typically presents as PEA."
    },

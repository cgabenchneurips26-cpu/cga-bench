      "action_id": "obtain_last_known_well_time",
      "timestamp_minutes": 5.0,
      "type": "reassess",
      "args": {},
      "justification": "Determining last known well time is critical to establish eligibility for tPA and/or mechanical thrombectomy within their respective time windows."
    },
    {
      "action_id": "perform_nihss",
      "timestamp_minutes": 10.0,
      "type": "reassess",
      "args": {},
      "justification": "The NIHSS quantifies stroke severity, guides treatment decisions (tPA eligibility, thrombectomy candidacy), and establishes a baseline for monitoring."
    },
    {
      "action_id": "order_stat_ct_head",
      "timestamp_minutes": 15.0,
      "type": "order_imaging",
      "args": {
        "imaging_type": "ct"
      },
      "justification": "Mandatory - Stat non-contrast CT head is the first critical imaging step to rule out hemorrhage before any thrombolytic therapy in acute ischemic stroke."
    },
    {
      "action_id": "check_glucose",
      "timestamp_minutes": 20.0,
      "type": "order_lab",
      "args": {
        "test_code": "unknown"
      },
      "justification": "Mandatory - Hypoglycemia can mimic stroke; blood glucose must be checked immediately to rule out metabolic cause and guide treatment."
    },
    {
      "action_id": "establish_iv_access",
      "timestamp_minutes": 25.0,
      "type": "reassess",
      "args": {},
      "justification": "Mandatory - IV access is required for any medication administration including tPA if indicated."
    },
    {
      "action_id": "obtain_12_lead_ecg",
      "timestamp_minutes": 30.0,
      "type": "order_imaging",
      "args": {
        "imaging_type": "ecg"
      },
      "justification": "Mandatory action: ECG is required in acute ischemic stroke workup to identify atrial fibrillation or other cardiac arrhythmias that may be the cardioembolic source and guide anticoagulation decisions."
    },
    {
      "action_id": "order_cbc_bmp_coag",
      "timestamp_minutes": 35.0,
      "type": "order_lab",
      "args": {
        "test_code": "cbc"
      },
      "justification": "Mandatory action: CBC, BMP, and coagulation studies are essential to assess for contraindications to tPA (e.g., platelet count, INR, renal function) and overall metabolic status prior to treatment decisions."
    },
    {
      "action_id": "assess_prestroke_mrs",
      "timestamp_minutes": 40.0,
      "type": "reassess",
      "args": {},
      "justification": "Optional but clinically important: Assessing pre-stroke modified Rankin Scale establishes baseline functional status, which is critical for determining eligibility and benefit-risk ratio for thrombolysis or thrombectomy."
    },
    {
      "action_id": "assess_aspects_score",
      "timestamp_minutes": 45.0,
      "type": "order_imaging",
      "args": {
        "imaging_type": "ct"
      },
      "justification": "With CT head already ordered, ASPECTS score assessment is the next critical step to evaluate extent of early ischemic changes and guide eligibility for reperfusion therapy in acute ischemic stroke."
    },
    {
      "action_id": "activate_neurointerventional_team",
      "timestamp_minutes": 50.0,
      "type": "order_imaging",
      "args": {
        "imaging_type": "ct"
      },
      "justification": "Early activation of the neurointerventional team is essential given acute ischemic stroke presentation; time is critical for potential mechanical thrombectomy if large vessel occlusion is identified."
    },
    {
      "action_id": "admit_to_icu_or_stroke_unit",
      "timestamp_minutes": 55.0,
      "type": "disposition",
      "args": {},
      "justification": "Patient with acute ischemic stroke requires admission to a stroke unit or ICU for continuous monitoring, regardless of reperfusion therapy decision."
    }

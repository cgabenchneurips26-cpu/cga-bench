      "timestamp_minutes": 80.0,
      "type": "reassess",
      "args": {},
      "justification": "Following fluid resuscitation with Parkland formula, compartment syndrome is a risk in burn patients, especially with circumferential or deep burns. Assess compartment pressures to detect early signs."
    },
    {
      "action_id": "assess_distal_pulses",
      "timestamp_minutes": 85.0,
      "type": "reassess",
      "args": {},
      "justification": "Assess distal pulses to evaluate for vascular compromise secondary to burn eschar or edema, which may indicate need for escharotomy."
    },
    {

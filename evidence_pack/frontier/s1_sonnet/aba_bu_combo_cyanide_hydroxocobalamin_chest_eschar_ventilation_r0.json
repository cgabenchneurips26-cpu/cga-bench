    {
      "action_id": "establish_iv_access",
      "timestamp_minutes": 15.0,
      "type": "reassess",
      "args": {},
      "justification": "Mandatory action: IV access is essential for fluid resuscitation in burn patients. Must be completed within the 60-minute deadline."
    },
    {
      "action_id": "estimate_tbsa",
      "timestamp_minutes": 20.0,
      "type": "reassess",
      "args": {},
      "justification": "Mandatory action: Estimating total body surface area (TBSA) burned is critical for calculating fluid resuscitation requirements using the Parkland formula."
    },
    {
      "action_id": "obtain_patient_weight",
      "timestamp_minutes": 25.0,
      "type": "reassess",
      "args": {},
      "justification": "Mandatory action: Patient weight is required for accurate Parkland formula fluid resuscitation calculation (4 mL/kg/% TBSA)."
    },
    {
      "action_id": "calculate_parkland_formula",
      "timestamp_minutes": 30.0,
      "type": "reassess",
      "args": {},
      "justification": "Mandatory: Calculate 24-hour fluid resuscitation volume using Parkland formula (4 mL \u00d7 kg \u00d7 %TBSA) now that weight and TBSA are known. Half given in first 8 hours, half in next 16 hours."
    },
    {
      "action_id": "place_foley_catheter",
      "timestamp_minutes": 35.0,
      "type": "reassess",
      "args": {},
      "justification": "Mandatory: Insert Foley catheter to allow accurate hourly urine output monitoring, which is the primary endpoint for guiding fluid resuscitation in burn patients."
    },
    {
      "action_id": "start_lactated_ringers",
      "timestamp_minutes": 40.0,
      "type": "give_medication",
      "args": {
        "medication_code": "unknown",
        "dose": "standard"
      },
      "justification": "Mandatory: Initiate Lactated Ringer's solution per burn resuscitation protocol \u2014 LR is the preferred crystalloid for burn fluid resuscitation as it most closely resembles physiologic fluid."
    },
    {
      "action_id": "monitor_urine_output_target_0_5_ml_kg_h",
      "timestamp_minutes": 45.0,
      "type": "order_lab",
      "args": {
        "test_code": "unknown"
      },
      "justification": "MANDATORY: With Foley catheter in place, urine output must be monitored continuously targeting 0.5 mL/kg/h to guide Parkland formula fluid resuscitation adequacy in burn patients."
    },
    {
      "action_id": "titrate_fluids_to_urine_output",
      "timestamp_minutes": 50.0,
      "type": "give_medication",
      "args": {
        "medication_code": "fluid",
        "dose": "standard"
      },
      "justification": "MANDATORY: Fluid rate should be titrated based on urine output response - increase if output <0.5 mL/kg/h, decrease if >1 mL/kg/h, per standard burn resuscitation protocol."
    },
    {
      "action_id": "assess_inhalation_injury_signs",
      "timestamp_minutes": 55.0,
      "type": "reassess",
      "args": {},
      "justification": "Inhalation injury must be assessed in burn patients as it significantly affects prognosis and may require early intubation; signs include singed nasal hairs, carbonaceous sputum, hoarseness, and facial burns."
    },
    {
      "action_id": "give_100_percent_oxygen",
      "timestamp_minutes": 60.0,
      "type": "give_medication",
      "args": {
        "medication_code": "unknown",
        "dose": "standard"
      },
      "justification": "Burn patients with potential inhalation injury should receive high-flow 100% oxygen via non-rebreather mask to address possible carbon monoxide exposure and airway compromise, even if SpO2 appears normal (pulse oximetry cannot distinguish carboxyhemoglobin)."
    },
    {
      "action_id": "assess_burn_center_referral_criteria",

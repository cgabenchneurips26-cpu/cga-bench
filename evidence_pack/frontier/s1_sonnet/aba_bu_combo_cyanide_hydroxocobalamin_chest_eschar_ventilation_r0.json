      "timestamp_minutes": 70.0,
      "type": "reassess",
      "args": {},
      "justification": "Burn wounds should be covered with clean dry dressings to prevent contamination, reduce fluid/heat loss, and minimize pain while awaiting definitive wound care."
    },
    {

      "type": "reassess",
      "args": {},
      "justification": "MANDATORY and highest priority given known inhalation injury comorbidity. Airway compromise is the most immediately life-threatening concern in burn patients with inhalation injury."
    },
    {
      "action_id": "assess_vital_signs",
      "timestamp_minutes": 5.0,
      "type": "reassess",
      "args": {},
      "justification": "MANDATORY baseline vital signs assessment to establish hemodynamic status and guide resuscitation."
    },
    {
      "action_id": "assess_burn_depth",
      "timestamp_minutes": 10.0,
      "type": "reassess",
      "args": {},
      "justification": "MANDATORY assessment to determine burn severity and guide treatment planning."
    },
    {
      "action_id": "establish_iv_access",
      "timestamp_minutes": 15.0,
      "type": "reassess",
      "args": {},
      "justification": "Mandatory action - IV access is essential for fluid resuscitation in burn patients. With inhalation injury, large-bore IV access is critical for delivering calculated fluids per Parkland formula."
    },
    {
      "action_id": "estimate_tbsa",
      "timestamp_minutes": 20.0,
      "type": "reassess",
      "args": {},
      "justification": "Mandatory action - TBSA estimation is required to calculate fluid resuscitation volume using the Parkland formula (4 mL x kg x % TBSA). Must be completed within 60-minute deadline."
    },
    {
      "action_id": "obtain_patient_weight",
      "timestamp_minutes": 25.0,
      "type": "reassess",
      "args": {},
      "justification": "Mandatory action - Patient weight is required alongside TBSA to calculate the Parkland formula fluid resuscitation volume. Must be completed within 60-minute deadline."
    },
    {
      "action_id": "calculate_parkland_formula",
      "timestamp_minutes": 30.0,
      "type": "reassess",
      "args": {},
      "justification": "Mandatory: Calculate the Parkland formula (4 mL x kg x %TBSA) to determine total fluid resuscitation volume needed in the first 24 hours, now that weight and TBSA have been assessed."
    },
    {
      "action_id": "place_foley_catheter",
      "timestamp_minutes": 35.0,
      "type": "reassess",
      "args": {},
      "justification": "Mandatory: Place Foley catheter to enable accurate urine output monitoring, which is the primary endpoint for fluid resuscitation titration in burn patients."
    },
    {
      "action_id": "start_lactated_ringers",
      "timestamp_minutes": 40.0,
      "type": "give_medication",
      "args": {
        "medication_code": "unknown",
        "dose": "standard"
      },
      "justification": "Mandatory: Initiate Lactated Ringer's solution per burn resuscitation guidelines (Parkland formula), with half the calculated 24-hour volume given in the first 8 hours from time of burn."
    },
    {
      "action_id": "monitor_urine_output_target_0_5_ml_kg_h",
      "timestamp_minutes": 45.0,
      "type": "order_lab",
      "args": {
        "test_code": "unknown"
      },
      "justification": "Mandatory action: Urine output monitoring targeting 0.5 ml/kg/h is the primary endpoint for fluid resuscitation adequacy in burn patients per Parkland formula guidelines. Foley is already in place."
    },
    {
      "action_id": "titrate_fluids_to_urine_output",
      "timestamp_minutes": 50.0,
      "type": "give_medication",
      "args": {
        "medication_code": "fluid",
        "dose": "standard"
      },
      "justification": "Mandatory action: Fluid resuscitation must be titrated to urine output to avoid both under-resuscitation (organ failure) and over-resuscitation (pulmonary edema, abdominal compartment syndrome), especially important with concurrent inhalation injury."
    },
    {
      "action_id": "assess_inhalation_injury_signs",
      "timestamp_minutes": 55.0,
      "type": "reassess",
      "args": {},
      "justification": "Patient has documented inhalation injury comorbidity. Assessing for signs such as carbonaceous sputum, singed nasal hairs, stridor, hoarseness, and facial burns is critical to guide airway management decisions including possible early intubation or bronchoscopy."
    },
    {
      "action_id": "give_100_percent_oxygen",
      "timestamp_minutes": 60.0,
      "type": "give_medication",
      "args": {
        "medication_code": "unknown",
        "dose": "standard"
      },
      "justification": "Patient has documented inhalation injury. High-flow 100% oxygen via non-rebreather mask is a critical early intervention to treat potential carbon monoxide poisoning and hypoxia associated with inhalation injury, even if SpO2 appears normal (pulse oximetry cannot distinguish carboxyhemoglobin)."
    },
    {
      "action_id": "bronchoscopy_if_suspected",
      "timestamp_minutes": 65.0,
      "type": "order_imaging",
      "args": {
        "imaging_type": "ct"
      },
      "justification": "With confirmed inhalation injury, bronchoscopy is indicated to directly visualize the extent of airway injury, assess for soot, mucosal damage, and carbonaceous deposits, and guide airway management decisions."
    },
    {
      "action_id": "assess_burn_center_referral_criteria",
      "timestamp_minutes": 70.0,
      "type": "reassess",
      "args": {},
      "justification": "Inhalation injury is a primary criterion for burn center referral per ABA guidelines. Assessment of referral criteria should be performed to ensure this patient receives appropriate level of care."
    },
    {
      "action_id": "give_hydroxocobalamin",
      "timestamp_minutes": 75.0,
      "type": "give_medication",
      "args": {
        "medication_code": "unknown",
        "dose": "standard"
      },
      "justification": "Inhalation injury with smoke exposure raises concern for cyanide toxicity. Hydroxocobalamin is the antidote of choice for cyanide poisoning from smoke inhalation and should be administered empirically given the comorbidity."
    },
    {
      "action_id": "consult_burn_center",
      "timestamp_minutes": 80.0,
      "type": "consult",
      "args": {},
      "justification": "Patient with burns and confirmed inhalation injury requires burn center consultation for specialized management, airway monitoring, and disposition planning."
    },
    {
      "action_id": "cover_with_clean_dry_dressing",
      "timestamp_minutes": 85.0,
      "type": "reassess",
      "args": {},
      "justification": "Standard burn wound care \u2014 covering burns with clean dry dressings prevents infection and reduces pain while avoiding hypothermia from wet dressings."
    },
    {
      "action_id": "monitor_airway_patency",
      "timestamp_minutes": 90.0,
      "type": "order_lab",
      "args": {
        "test_code": "unknown"
      },
      "justification": "Patient has inhalation injury; airway edema can progress over time and cause delayed obstruction. Continuous monitoring of airway patency is critical even if initially patent, especially at 90 minutes post-injury when edema typically peaks."
    },
    {
      "action_id": "assess_distal_pulses",
      "timestamp_minutes": 95.0,
      "type": "reassess",
      "args": {},
      "justification": "In burn patients, circumferential burns or significant edema can compromise distal circulation. Assessing distal pulses helps identify need for escharotomy or fasciotomy early."
    },
    {
      "action_id": "monitor_glucose_q4h",
      "timestamp_minutes": 100.0,
      "type": "order_lab",
      "args": {
        "test_code": "unknown"
      },
      "justification": "Burn patients are at risk for metabolic derangements. Regular glucose monitoring is standard supportive care, particularly important if the patient may require dextrose supplementation or has metabolic stress from the burn injury."
    },
    {
      "action_id": "order_carboxyhemoglobin",
      "timestamp_minutes": 105.0,
      "type": "reassess",
      "args": {},
      "justification": "Patient has inhalation injury; carboxyhemoglobin level is critical to assess CO poisoning severity and guide oxygen therapy duration, especially given the comorbidity of inhalation injury."
    },
    {
      "action_id": "order_chest_xray",
      "timestamp_minutes": 110.0,
      "type": "order_imaging",
      "args": {
        "imaging_type": "xray"
      },
      "justification": "Baseline chest X-ray is indicated in inhalation injury to assess for pulmonary infiltrates, airway edema, or early ARDS findings."
    },
    {
      "action_id": "monitor_ventilation_pressures",
      "timestamp_minutes": 115.0,
      "type": "order_lab",
      "args": {
        "test_code": "unknown"
      },
      "justification": "With inhalation injury, monitoring ventilation pressures helps detect increasing airway resistance or bronchospasm, guiding early intervention."
    }

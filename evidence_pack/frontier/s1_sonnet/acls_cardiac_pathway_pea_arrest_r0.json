      "timestamp_minutes": 0.0,
      "type": "reassess",
      "args": {},
      "justification": "First step in cardiac arrest protocol: confirm unresponsiveness, absence of pulse, and apnea to confirm cardiac arrest before initiating resuscitation."
    },
    {
      "action_id": "activate_code_team",
      "timestamp_minutes": 5.0,
      "type": "order_imaging",
      "args": {
        "imaging_type": "ct"
      },
      "justification": "Mandatory per ACLS guidelines: immediately activate the code team to ensure adequate personnel for resuscitation efforts."
    },
    {
      "action_id": "attach_defibrillator_pads",
      "timestamp_minutes": 10.0,
      "type": "order_lab",
      "args": {
        "test_code": "unknown"
      },
      "justification": "Mandatory per ACLS guidelines: attach defibrillator pads immediately to allow rhythm analysis and defibrillation if a shockable rhythm (VF/pVT) is identified."
    },
    {
      "action_id": "begin_high_quality_cpr",
      "timestamp_minutes": 15.0,
      "type": "reassess",
      "args": {},
      "justification": "MANDATORY action - cardiac arrest has been confirmed. High-quality CPR (rate 100-120/min, depth 2-2.4 inches, full chest recoil, minimize interruptions) must be initiated immediately as the cornerstone of resuscitation per ACLS guidelines."
    },
    {
      "action_id": "analyze_rhythm",
      "timestamp_minutes": 20.0,
      "type": "reassess",
      "args": {},
      "justification": "After initiating CPR, rhythm analysis is critical to determine if the arrest is due to a shockable rhythm (VF/pVT) or non-shockable rhythm (PEA/asystole), which will guide the next steps in the ACLS algorithm."
    },
    {
      "action_id": "apply_end_tidal_co2_monitoring",
      "timestamp_minutes": 25.0,
      "type": "order_lab",
      "args": {
        "test_code": "unknown"
      },
      "justification": "End-tidal CO2 monitoring should be applied to assess CPR quality (target ETCO2 \u226510-20 mmHg), guide resuscitation efforts, and detect return of spontaneous circulation (sudden increase in ETCO2 \u226540 mmHg)."
    },
    {
      "action_id": "establish_iv_io_access",
      "timestamp_minutes": 30.0,
      "type": "reassess",
      "args": {},
      "justification": "IV/IO access is essential for administering medications (epinephrine, amiodarone) during cardiac arrest resuscitation. This is a priority early step after CPR initiation and rhythm analysis."
    },
    {
      "action_id": "evaluate_reversible_causes",
      "timestamp_minutes": 35.0,
      "type": "reassess",
      "args": {},
      "justification": "Identifying and treating reversible causes (Hs and Ts: hypoxia, hypovolemia, hyperkalemia, hypothermia, tension pneumothorax, tamponade, toxins, thrombosis) is a critical component of ACLS cardiac arrest management and guides further treatment."
    },
    {
      "action_id": "continue_high_quality_cpr",
      "timestamp_minutes": 40.0,
      "type": "reassess",
      "args": {},
      "justification": "High-quality CPR must be maintained continuously during cardiac arrest resuscitation to sustain perfusion pressure until ROSC is achieved."
    },
    {
      "action_id": "deliver_defibrillation",
      "timestamp_minutes": 45.0,
      "type": "reassess",
      "args": {},
      "justification": "If rhythm analysis revealed VF or pulseless VT, immediate defibrillation is the highest priority intervention per ACLS guidelines for shockable rhythms."
    },
    {
      "action_id": "give_amiodarone_300mg",
      "timestamp_minutes": 50.0,
      "type": "give_medication",
      "args": {
        "medication_code": "unknown",
        "dose": "standard"
      },
      "justification": "Amiodarone 300mg IV is indicated for refractory VF/pVT after initial defibrillation attempts per ACLS cardiac arrest algorithm."
    },
    {
      "action_id": "continue_cpr",
      "timestamp_minutes": 55.0,
      "type": "reassess",
      "args": {},
      "justification": "High-quality CPR should be continued between defibrillation attempts and medication administration to maintain perfusion during cardiac arrest resuscitation."
    },

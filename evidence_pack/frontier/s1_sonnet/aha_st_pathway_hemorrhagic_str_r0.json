    },
    {
      "action_id": "perform_nihss",
      "timestamp_minutes": 10.0,
      "type": "reassess",
      "args": {},
      "justification": "NIHSS assessment is mandatory to quantify neurological deficit severity and guide management decisions for this hemorrhagic stroke patient."
    },
    {
      "action_id": "order_stat_ct_head",
      "timestamp_minutes": 15.0,
      "type": "order_imaging",
      "args": {
        "imaging_type": "ct"
      },
      "justification": "\u2605 MANDATORY: Stat CT head is the most urgent action for hemorrhagic stroke to characterize the hemorrhage (ICH vs SAH), assess volume, location, and identify any hydrocephalus or herniation. This is the cornerstone of hemorrhagic stroke management."
    },
    {
      "action_id": "establish_iv_access",
      "timestamp_minutes": 20.0,
      "type": "reassess",
      "args": {},
      "justification": "\u2605 MANDATORY: IV access is required for medication administration, blood draws, and potential reversal agents or blood pressure management in hemorrhagic stroke."
    },
    {
      "action_id": "check_glucose",
      "timestamp_minutes": 25.0,
      "type": "order_lab",
      "args": {
        "test_code": "unknown"
      },
      "justification": "\u2605 MANDATORY: Glucose check is essential to rule out hypoglycemia as a stroke mimic and because dysglycemia worsens outcomes in hemorrhagic stroke. Must be done urgently."
    },
    {
      "action_id": "obtain_12_lead_ecg",
      "timestamp_minutes": 30.0,
      "type": "order_imaging",
      "args": {
        "imaging_type": "ecg"
      },
      "justification": "MANDATORY: 12-lead ECG is critical in subarachnoid hemorrhage as it can cause dramatic ECG changes (ST elevation, T-wave inversions, QTc prolongation) mimicking cardiac ischemia. Also detects atrial fibrillation or other arrhythmias that may be relevant."
    },
    {
      "action_id": "order_cbc_bmp_coag",
      "timestamp_minutes": 35.0,
      "type": "order_lab",
      "args": {
        "test_code": "cbc"
      },
      "justification": "MANDATORY: CBC, BMP, and coagulation studies are essential in hemorrhagic stroke to assess platelet count, hemoglobin, electrolytes, renal function, and coagulation status (PT/INR/aPTT) which directly impact management decisions including reversal of anticoagulation if applicable."
    },
    {
      "action_id": "assess_prestroke_mrs",
      "timestamp_minutes": 40.0,
      "type": "reassess",
      "args": {},
      "justification": "Assessing pre-stroke modified Rankin Scale (mRS) establishes baseline functional status, which is essential for guiding treatment decisions and prognostication in hemorrhagic stroke."
    },
    {
      "action_id": "assess_aspects_score",
      "timestamp_minutes": 45.0,
      "type": "order_imaging",
      "args": {
        "imaging_type": "ct"
      },
      "justification": "Patient has hemorrhagic stroke/ICH/SAH - ASPECTS score assessment is critical to evaluate extent of involvement and guide management decisions after CT head has been completed."
    },
    {
      "action_id": "assess_surgical_risk",
      "timestamp_minutes": 50.0,
      "type": "reassess",
      "args": {},
      "justification": "For ICH/SAH patient, surgical intervention (e.g., hematoma evacuation, clipping/coiling) may be indicated - early surgical risk assessment is essential to determine candidacy."
    },
    {
      "action_id": "activate_neurointerventional_team",
      "timestamp_minutes": 55.0,
      "type": "order_imaging",
      "args": {
        "imaging_type": "ct"
      },
      "justification": "SAH/ICH may require urgent neurosurgical or neurointerventional intervention (aneurysm coiling, hematoma evacuation) - activating the neurointerventional team early ensures readiness."
    },
    {
      "action_id": "assess_vital_signs",
      "timestamp_minutes": 60.0,
      "type": "reassess",
      "args": {},
      "justification": "Serial vital sign monitoring is essential in hemorrhagic stroke/ICH/SAH to detect hypertensive surges, hemodynamic instability, or neurological deterioration. Initial vitals show stable BP 120/80 but ongoing monitoring is critical."
    },
    {
      "action_id": "admit_to_icu",
      "timestamp_minutes": 65.0,
      "type": "disposition",
      "args": {},
      "justification": "Patient with intracerebral hemorrhage and subarachnoid hemorrhage requires ICU-level monitoring for close neurological observation, BP management, and detection of rebleeding or vasospasm."
    }
  ],

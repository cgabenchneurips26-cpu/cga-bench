      },
      "justification": "Apply end-tidal CO2 monitoring to confirm correct endotracheal tube placement if intubated, assess CPR quality (target ETCO2 >10 mmHg), and as a prognostic indicator of ROSC (sudden increase in ETCO2 suggests return of spontaneous circulation)."
    },
    {
      "action_id": "continue_high_quality_cpr",
      "timestamp_minutes": 30.0,
      "type": "reassess",
      "args": {},
      "justification": "Per AHA ACLS guidelines, continuous high-quality CPR is essential during cardiac arrest to maintain perfusion. This is a required action for asystole/PEA management."
    },
    {
      "action_id": "evaluate_reversible_causes",
      "timestamp_minutes": 35.0,
      "type": "reassess",
      "args": {},
      "justification": "AHA ACLS guidelines mandate evaluation of reversible causes (H's and T's: hypovolemia, hypoxia, hydrogen ion, hypo/hyperkalemia, hypothermia, tension pneumothorax, tamponade, toxins, thrombosis) to identify and treat underlying etiology of cardiac arrest."
    },
    {
      "action_id": "establish_iv_io_access",
      "timestamp_minutes": 40.0,
      "type": "reassess",
      "args": {},
      "justification": "IV/IO access is required to administer epinephrine and other resuscitation medications. This is a critical next step to enable pharmacological treatment per ACLS protocol."
    },
    {
      "action_id": "continue_cpr",
      "timestamp_minutes": 45.0,
      "type": "reassess",
      "args": {},
      "justification": "High-quality CPR must be maintained continuously during cardiac arrest resuscitation to maintain perfusion pressure until ROSC is achieved."
    },
    {
      "action_id": "deliver_defibrillation",
      "timestamp_minutes": 50.0,
      "type": "reassess",
      "args": {},
      "justification": "If rhythm analysis revealed a shockable rhythm (VF/pVT), immediate defibrillation is the first priority per AHA ACLS guidelines. Defibrillation should not be delayed for shockable rhythms."
    },
    {

      },
      "justification": "End-tidal CO2 monitoring provides real-time feedback on CPR quality and can confirm ROSC; values >10 mmHg suggest adequate CPR, while a sudden rise may indicate return of spontaneous circulation."
    },
    {
      "action_id": "continue_high_quality_cpr",
      "timestamp_minutes": 30.0,
      "type": "reassess",
      "args": {},
      "justification": "Continuous high-quality CPR is mandatory per AHA ACLS guidelines for cardiac arrest to maintain perfusion during resuscitation efforts."
    },
    {

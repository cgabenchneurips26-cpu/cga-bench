      "timestamp_minutes": 80.0,
      "type": "reassess",
      "args": {},
      "justification": "Circumferential burns or significant fluid resuscitation can lead to compartment syndrome; assess compartment pressures especially in extremity burns."
    },
    {
      "action_id": "assess_distal_pulses",
      "timestamp_minutes": 85.0,
      "type": "reassess",
      "args": {},
      "justification": "Monitor distal pulses to detect vascular compromise from circumferential burns or edema, which may indicate need for escharotomy."
    },
    {
      "action_id": "monitor_airway_patency",
      "timestamp_minutes": 90.0,
      "type": "order_lab",
      "args": {
        "test_code": "unknown"
      },
      "justification": "Continued airway monitoring is essential in burn patients, especially if inhalation injury was assessed, as airway edema can progress over time and lead to obstruction."
    },
    {

      "type": "reassess",
      "args": {},
      "justification": "Airway assessment is the highest priority in burn care \u2014 inhalation injury or airway compromise can be rapidly fatal. Must be assessed first before any other intervention."
    },
    {
      "action_id": "assess_vital_signs",
      "timestamp_minutes": 5.0,
      "type": "reassess",
      "args": {},
      "justification": "Mandatory baseline vital signs assessment to establish hemodynamic status and identify any instability in this burn patient."
    },
    {
      "action_id": "assess_burn_depth",
      "timestamp_minutes": 10.0,
      "type": "reassess",
      "args": {},
      "justification": "Mandatory assessment of burn depth (superficial, partial-thickness, full-thickness) to guide treatment decisions and fluid resuscitation needs."
    },
    {
      "action_id": "establish_iv_access",
      "timestamp_minutes": 15.0,
      "type": "reassess",
      "args": {},
      "justification": "Mandatory action: IV access is required for fluid resuscitation per burn management guidelines. Large-bore IV access must be established early in burn care."
    },
    {
      "action_id": "estimate_tbsa",
      "timestamp_minutes": 20.0,
      "type": "reassess",
      "args": {},
      "justification": "Mandatory action: Estimating total body surface area (TBSA) burned is essential to calculate fluid resuscitation requirements using the Parkland formula and to determine burn severity and transfer criteria."
    },
    {
      "action_id": "obtain_patient_weight",
      "timestamp_minutes": 25.0,
      "type": "reassess",
      "args": {},
      "justification": "Mandatory action: Patient weight is required to calculate Parkland formula fluid resuscitation (4 mL/kg/% TBSA burned). Must be obtained early in burn management."
    },
    {
      "action_id": "calculate_parkland_formula",
      "timestamp_minutes": 30.0,
      "type": "reassess",
      "args": {},
      "justification": "Calculate the Parkland formula (4 mL \u00d7 kg \u00d7 %TBSA) to determine the total fluid resuscitation volume for the first 24 hours. Weight and TBSA have already been assessed, making this immediately actionable."
    },
    {
      "action_id": "place_foley_catheter",
      "timestamp_minutes": 35.0,
      "type": "reassess",
      "args": {},
      "justification": "Insert a Foley catheter to accurately monitor urine output, which is the primary endpoint for fluid resuscitation adequacy in burn patients (target 0.5 mL/kg/h for adults)."
    },
    {
      "action_id": "start_lactated_ringers",
      "timestamp_minutes": 40.0,
      "type": "give_medication",
      "args": {
        "medication_code": "unknown",
        "dose": "standard"
      },
      "justification": "Initiate Lactated Ringer's solution as per burn resuscitation guidelines (Parkland formula). LR is the preferred crystalloid for burn resuscitation within the first 24 hours."
    },
    {
      "action_id": "monitor_urine_output_target_0_5_ml_kg_h",
      "timestamp_minutes": 45.0,
      "type": "order_lab",
      "args": {
        "test_code": "unknown"
      },
      "justification": "Mandatory action: Urine output is the primary endpoint for fluid resuscitation in burn patients. Target is 0.5 ml/kg/h in adults to ensure adequate perfusion without over-resuscitation."
    },
    {
      "action_id": "titrate_fluids_to_urine_output",
      "timestamp_minutes": 50.0,
      "type": "give_medication",
      "args": {
        "medication_code": "fluid",
        "dose": "standard"
      },
      "justification": "Mandatory action: Fluid rates should be adjusted based on urine output to maintain target of 0.5 ml/kg/h per Parkland formula guidelines, adjusting LR infusion up or down as needed."
    },
    {
      "action_id": "assess_inhalation_injury_signs",
      "timestamp_minutes": 55.0,
      "type": "reassess",
      "args": {},
      "justification": "Optional but clinically important: Inhalation injury significantly worsens prognosis in burn patients and may require early intubation. Signs include singed nasal hairs, carbonaceous sputum, hoarseness, and facial burns."
    },
    {
      "action_id": "give_100_percent_oxygen",
      "timestamp_minutes": 60.0,
      "type": "give_medication",
      "args": {
        "medication_code": "unknown",
        "dose": "standard"
      },
      "justification": "Patient with burn injury should receive 100% oxygen via non-rebreather mask to address potential carbon monoxide exposure and support tissue oxygenation, especially given inhalation injury concerns already assessed."
    },
    {

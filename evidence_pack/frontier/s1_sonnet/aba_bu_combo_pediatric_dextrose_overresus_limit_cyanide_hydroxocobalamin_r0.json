      "timestamp_minutes": 95.0,
      "type": "order_lab",
      "args": {
        "test_code": "unknown"
      },
      "justification": "Regular glucose monitoring is important in burn patients due to metabolic stress response causing hyperglycemia; q4h monitoring allows timely intervention."

      "timestamp_minutes": 65.0,
      "type": "reassess",
      "args": {},
      "justification": "Per burn guidelines, all significant burns should be evaluated for burn center referral criteria (TBSA >10%, full thickness burns, burns to special areas, inhalation injury, etc.)."
    },

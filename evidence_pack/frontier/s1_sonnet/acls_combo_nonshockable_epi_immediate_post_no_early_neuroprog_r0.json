    {
      "action_id": "attach_defibrillator_pads",
      "timestamp_minutes": 15.0,
      "type": "reassess",
      "args": {},
      "justification": "MANDATORY action - Attaching defibrillator pads is required immediately to analyze cardiac rhythm. This determines whether the arrest is a shockable rhythm (VF/pVT requiring immediate defibrillation) or non-shockable (asystole/PEA requiring epinephrine and reversible cause evaluation). Cannot proceed with targeted ACLS treatment without rhythm analysis."
    },
    {
      "action_id": "analyze_rhythm",
      "timestamp_minutes": 20.0,
      "type": "reassess",
      "args": {},
      "justification": "Once pads are attached, rhythm analysis is the critical next step to differentiate shockable (VF/pVT) from non-shockable (asystole/PEA) rhythms. This directly determines the treatment pathway per AHA ACLS guidelines."
    },
    {
      "action_id": "apply_end_tidal_co2_monitoring",
      "timestamp_minutes": 25.0,
      "type": "order_lab",
      "args": {
        "test_code": "unknown"
      },
      "justification": "End-tidal CO2 monitoring during CPR provides real-time feedback on CPR quality and can serve as an early indicator of ROSC (return of spontaneous circulation). ETCO2 >10 mmHg suggests adequate CPR; sudden rise to >40 mmHg indicates ROSC."
    },
    {
      "action_id": "continue_high_quality_cpr",
      "timestamp_minutes": 30.0,
      "type": "reassess",
      "args": {},
      "justification": "High-quality CPR is the cornerstone of cardiac arrest management and must be maintained continuously per AHA ACLS guidelines."
    },
    {
      "action_id": "establish_iv_io_access",
      "timestamp_minutes": 35.0,
      "type": "reassess",
      "args": {},
      "justification": "IV/IO access is needed immediately to administer epinephrine as soon as feasible, which is the first-line pharmacologic intervention for asystole/PEA per AHA ACLS guidelines."
    },
    {
      "action_id": "evaluate_reversible_causes",
      "timestamp_minutes": 40.0,
      "type": "reassess",
      "args": {},
      "justification": "Identifying and treating reversible causes (Hs and Ts) is a mandatory component of cardiac arrest management per AHA ACLS guidelines and may identify a treatable etiology."
    },
    {
      "action_id": "continue_cpr",
      "timestamp_minutes": 45.0,
      "type": "reassess",
      "args": {},
      "justification": "High-quality CPR must be maintained continuously during cardiac arrest resuscitation per AHA ACLS guidelines. This is a core ongoing intervention."
    },

      "timestamp_minutes": 90.0,
      "type": "order_lab",
      "args": {
        "test_code": "unknown"
      },
      "justification": "Ongoing airway monitoring is critical in burn patients, especially given prior assessment of inhalation injury signs. Airway edema can progress over time and requires serial reassessment."
    },

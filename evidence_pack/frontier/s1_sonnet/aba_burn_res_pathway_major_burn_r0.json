      "type": "reassess",
      "args": {},
      "justification": "Airway assessment is the highest priority in burn patients \u2014 inhalation injury or airway edema can be immediately life-threatening and must be identified first."
    },
    {
      "action_id": "assess_vital_signs",
      "timestamp_minutes": 5.0,
      "type": "reassess",
      "args": {},
      "justification": "Mandatory baseline vital sign assessment to establish hemodynamic status and guide resuscitation decisions in this burn patient."
    },
    {
      "action_id": "assess_burn_depth",
      "timestamp_minutes": 10.0,
      "type": "reassess",
      "args": {},
      "justification": "Burn depth assessment (superficial, partial-thickness, full-thickness) is mandatory to classify injury severity and guide management."
    },
    {
      "action_id": "establish_iv_access",
      "timestamp_minutes": 15.0,
      "type": "reassess",
      "args": {},
      "justification": "\u2605 MANDATORY: Large-bore IV access is essential for fluid resuscitation in burn patients. Must be established immediately to allow administration of crystalloid fluids per Parkland formula."
    },
    {
      "action_id": "estimate_tbsa",
      "timestamp_minutes": 20.0,
      "type": "reassess",
      "args": {},
      "justification": "\u2605 MANDATORY: Estimating total body surface area burned (using Rule of Nines or Lund-Browder chart) is required to calculate fluid resuscitation volume via the Parkland formula and to determine severity of burn injury."
    },
    {
      "action_id": "obtain_patient_weight",
      "timestamp_minutes": 25.0,
      "type": "reassess",
      "args": {},
      "justification": "\u2605 MANDATORY: Patient weight in kilograms is required for Parkland formula calculation (4 mL x kg x %TBSA = total 24-hour fluid requirement). Must be obtained before fluid resuscitation can be properly dosed."
    },
    {
      "action_id": "calculate_parkland_formula",
      "timestamp_minutes": 30.0,
      "type": "reassess",
      "args": {},
      "justification": "Mandatory: Calculate total fluid requirement for first 24 hours using Parkland formula (4 mL x kg x %TBSA) based on already obtained patient weight and TBSA estimate. Half given in first 8 hours, half in next 16 hours."
    },
    {
      "action_id": "place_foley_catheter",
      "timestamp_minutes": 35.0,
      "type": "reassess",
      "args": {},
      "justification": "Mandatory: Place Foley catheter to enable accurate hourly urine output monitoring, which is the primary endpoint for guiding fluid resuscitation in burn patients."
    },
    {
      "action_id": "start_lactated_ringers",
      "timestamp_minutes": 40.0,
      "type": "give_medication",
      "args": {
        "medication_code": "unknown",
        "dose": "standard"
      },
      "justification": "Mandatory: Initiate Lactated Ringer's solution as the standard isotonic crystalloid for burn resuscitation per ABA guidelines. Rate based on Parkland formula calculation."
    },
    {
      "action_id": "monitor_urine_output_target_0_5_ml_kg_h",
      "timestamp_minutes": 45.0,
      "type": "order_lab",
      "args": {
        "test_code": "unknown"
      },
      "justification": "MANDATORY: With Foley in place, urine output must be monitored targeting 0.5 ml/kg/h to guide fluid resuscitation adequacy per Parkland formula protocol."
    },
    {
      "action_id": "titrate_fluids_to_urine_output",
      "timestamp_minutes": 50.0,
      "type": "give_medication",
      "args": {
        "medication_code": "fluid",
        "dose": "standard"
      },
      "justification": "MANDATORY: Lactated Ringer's infusion rate should be titrated based on urine output to avoid under- or over-resuscitation in burn patients."
    },
    {
      "action_id": "assess_inhalation_injury_signs",
      "timestamp_minutes": 55.0,
      "type": "reassess",
      "args": {},
      "justification": "Inhalation injury is a critical complication in burn patients that significantly affects prognosis and management; must be assessed early to determine if bronchoscopy or early intubation is needed."
    },
    {
      "action_id": "give_100_percent_oxygen",
      "timestamp_minutes": 60.0,
      "type": "give_medication",
      "args": {
        "medication_code": "unknown",
        "dose": "standard"
      },
      "justification": "Patient with burn injury should receive high-flow 100% oxygen, especially to address potential carbon monoxide poisoning or inhalation injury that may not yet be clinically apparent."
    },
    {
      "action_id": "assess_burn_center_referral_criteria",
      "timestamp_minutes": 65.0,
      "type": "reassess",
      "args": {},
      "justification": "Evaluate whether this burn patient meets criteria for transfer to a specialized burn center based on TBSA, depth, location, and other factors per ABA guidelines."
    },
    {
      "action_id": "cover_with_clean_dry_dressing",
      "timestamp_minutes": 70.0,
      "type": "reassess",
      "args": {},
      "justification": "Cover burn wounds with clean dry dressings to prevent infection, reduce heat loss, and minimize pain while further management is arranged."
    },
    {

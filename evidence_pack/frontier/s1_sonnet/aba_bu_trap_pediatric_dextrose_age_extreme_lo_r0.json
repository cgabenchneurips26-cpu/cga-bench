    },
    {
      "action_id": "assess_burn_depth",
      "timestamp_minutes": 10.0,
      "type": "reassess",
      "args": {},
      "justification": "Mandatory assessment to classify burn severity (superficial, partial-thickness, full-thickness) which determines treatment plan and fluid resuscitation needs."
    },
    {
      "action_id": "establish_iv_access",
      "timestamp_minutes": 15.0,
      "type": "reassess",
      "args": {},
      "justification": "Mandatory action - IV access is essential for fluid resuscitation in burn patients. Large-bore IV access should be established early to deliver calculated resuscitation fluids per Parkland formula."
    },
    {
      "action_id": "estimate_tbsa",
      "timestamp_minutes": 20.0,
      "type": "reassess",
      "args": {},
      "justification": "Mandatory action - Estimating Total Body Surface Area (TBSA) burned is critical to determine burn severity, guide fluid resuscitation calculations, and assess need for burn center referral."
    },
    {
      "action_id": "obtain_patient_weight",
      "timestamp_minutes": 25.0,
      "type": "reassess",
      "args": {},
      "justification": "Mandatory action - Patient weight is required to calculate the Parkland formula for fluid resuscitation (4 mL x kg x %TBSA burned) and to dose medications appropriately."
    },
    {
      "action_id": "calculate_parkland_formula",
      "timestamp_minutes": 30.0,
      "type": "reassess",
      "args": {},
      "justification": "Calculate fluid resuscitation requirements using Parkland formula (4 mL x kg x %TBSA) now that weight and TBSA have been assessed. This determines total fluid volume needed in first 24 hours."
    },
    {
      "action_id": "place_foley_catheter",
      "timestamp_minutes": 35.0,
      "type": "reassess",
      "args": {},
      "justification": "Insert Foley catheter to enable accurate urine output monitoring, which is the primary endpoint for fluid resuscitation adequacy in burn patients."
    },
    {
      "action_id": "start_lactated_ringers",
      "timestamp_minutes": 40.0,
      "type": "give_medication",
      "args": {
        "medication_code": "unknown",
        "dose": "standard"
      },
      "justification": "Initiate Lactated Ringer's solution per burn resuscitation protocol \u2014 half of calculated 24-hour volume given in first 8 hours from time of burn."
    },
    {
      "action_id": "monitor_urine_output_target_0_5_ml_kg_h",
      "timestamp_minutes": 45.0,
      "type": "order_lab",
      "args": {
        "test_code": "unknown"
      },
      "justification": "Mandatory action: Urine output is the primary endpoint for burn fluid resuscitation. Target is 0.5 ml/kg/h in adults to ensure adequate end-organ perfusion without over-resuscitation."
    },
    {
      "action_id": "titrate_fluids_to_urine_output",
      "timestamp_minutes": 50.0,
      "type": "give_medication",
      "args": {
        "medication_code": "fluid",
        "dose": "standard"
      },
      "justification": "Mandatory action: Fluid rate should be titrated based on urine output rather than following the Parkland formula rigidly. Adjust LR rate up or down to maintain target UO of 0.5 ml/kg/h."
    },
    {
      "action_id": "assess_inhalation_injury_signs",
      "timestamp_minutes": 55.0,
      "type": "reassess",
      "args": {},
      "justification": "Optional but clinically important: Inhalation injury significantly increases mortality and fluid requirements. Signs such as singed nasal hairs, carbonaceous sputum, hoarseness, or facial burns should be evaluated to guide airway management decisions."
    },
    {
      "action_id": "give_100_percent_oxygen",
      "timestamp_minutes": 60.0,
      "type": "give_medication",
      "args": {
        "medication_code": "unknown",
        "dose": "standard"
      },
      "justification": "All burn patients, especially those with potential inhalation injury, should receive 100% oxygen via non-rebreather mask to treat or prevent carbon monoxide poisoning and support oxygenation."
    },
    {
      "action_id": "cover_with_clean_dry_dressing",
      "timestamp_minutes": 65.0,
      "type": "reassess",
      "args": {},
      "justification": "Covering burn wounds with clean dry dressings prevents infection, reduces heat and fluid loss, and provides comfort while definitive wound care is arranged."
    },
    {
      "action_id": "assess_burn_center_referral_criteria",
      "timestamp_minutes": 70.0,
      "type": "reassess",
      "args": {},
      "justification": "Assess whether this patient meets ABA criteria for burn center referral (e.g., TBSA >10%, full thickness burns, burns to face/hands/feet/genitalia/major joints, inhalation injury, etc.) to plan appropriate disposition."
    },
    {
      "action_id": "consult_burn_center",
      "timestamp_minutes": 75.0,
      "type": "consult",
      "args": {},
      "justification": "Burn center referral criteria have been assessed; now initiate consult with burn center for definitive management guidance, transfer planning, and specialized care coordination."
    },
    {
      "action_id": "assess_compartment_pressures",
      "timestamp_minutes": 80.0,
      "type": "reassess",
      "args": {},
      "justification": "Burns can cause compartment syndrome, especially circumferential burns. Assess compartment pressures to identify need for escharotomy or fasciotomy."
    },
    {
      "action_id": "assess_distal_pulses",
      "timestamp_minutes": 85.0,
      "type": "reassess",
      "args": {},
      "justification": "Evaluate distal pulses to assess for vascular compromise from circumferential burns or edema, which may necessitate escharotomy."
    },
    {
      "action_id": "monitor_airway_patency",
      "timestamp_minutes": 90.0,
      "type": "order_lab",
      "args": {
        "test_code": "unknown"
      },
      "justification": "Ongoing airway monitoring is critical in burn patients due to risk of progressive airway edema, especially with potential inhalation injury. Inhalation injury assessment was completed but airway status can evolve over time."
    },
    {
      "action_id": "monitor_glucose_q4h",
      "timestamp_minutes": 95.0,
      "type": "order_lab",
      "args": {
        "test_code": "unknown"
      },
      "justification": "Routine glucose monitoring every 4 hours is indicated in burn patients as metabolic stress can cause hyperglycemia or hypoglycemia, particularly important during fluid resuscitation."
    },
    {

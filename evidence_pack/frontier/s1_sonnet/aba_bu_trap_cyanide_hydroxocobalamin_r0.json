      "type": "reassess",
      "args": {},
      "justification": "Airway assessment is the highest priority in any burn patient \u2014 inhalation injury and airway compromise can be life-threatening and may require early intubation before edema develops."
    },
    {
      "action_id": "assess_vital_signs",
      "timestamp_minutes": 5.0,
      "type": "reassess",
      "args": {},
      "justification": "Mandatory baseline vital signs assessment to establish hemodynamic status and guide resuscitation in this burn patient."
    },
    {
      "action_id": "assess_burn_depth",
      "timestamp_minutes": 10.0,
      "type": "reassess",
      "args": {},
      "justification": "Burn depth assessment (superficial, partial thickness, full thickness) is mandatory to guide treatment decisions and determine if burn center referral is needed."
    },
    {
      "action_id": "establish_iv_access",
      "timestamp_minutes": 15.0,
      "type": "reassess",
      "args": {},
      "justification": "Mandatory action: IV access is essential for fluid resuscitation in burn patients. Must be completed within the 60-minute deadline."
    },
    {
      "action_id": "estimate_tbsa",
      "timestamp_minutes": 20.0,
      "type": "reassess",
      "args": {},
      "justification": "Mandatory action: Total Body Surface Area estimation is required to calculate fluid resuscitation volumes using the Parkland formula and to determine burn severity and transfer criteria."
    },
    {
      "action_id": "obtain_patient_weight",
      "timestamp_minutes": 25.0,
      "type": "reassess",
      "args": {},
      "justification": "Mandatory action: Patient weight is required for accurate Parkland formula calculation (4 mL x kg x %TBSA) to guide fluid resuscitation in the first 24 hours."
    },
    {
      "action_id": "calculate_parkland_formula",
      "timestamp_minutes": 30.0,
      "type": "reassess",
      "args": {},
      "justification": "Mandatory: Calculate Parkland formula (4 mL \u00d7 kg \u00d7 %TBSA) to determine total fluid resuscitation volume for the first 24 hours. This is the foundation of burn fluid management."
    },
    {
      "action_id": "place_foley_catheter",
      "timestamp_minutes": 35.0,
      "type": "reassess",
      "args": {},
      "justification": "Mandatory: Insert Foley catheter to continuously monitor urine output, which is the primary endpoint for titrating fluid resuscitation in burn patients (target 0.5 mL/kg/h in adults)."
    },
    {
      "action_id": "start_lactated_ringers",
      "timestamp_minutes": 40.0,
      "type": "give_medication",
      "args": {
        "medication_code": "unknown",
        "dose": "standard"
      },
      "justification": "Mandatory: Initiate Lactated Ringer's solution per Parkland formula. LR is the preferred crystalloid for burn resuscitation per ABA guidelines \u2014 half the calculated volume given in first 8 hours from time of burn."
    },
    {
      "action_id": "monitor_urine_output_target_0_5_ml_kg_h",
      "timestamp_minutes": 45.0,
      "type": "order_lab",
      "args": {
        "test_code": "unknown"
      },
      "justification": "Mandatory action: Urine output monitoring (target 0.5 ml/kg/h) is the primary endpoint for fluid resuscitation adequacy in burn patients. Foley is already in place, so ongoing UO monitoring must be established and tracked."
    },
    {
      "action_id": "titrate_fluids_to_urine_output",
      "timestamp_minutes": 50.0,
      "type": "give_medication",
      "args": {
        "medication_code": "fluid",
        "dose": "standard"
      },
      "justification": "Mandatory action: Parkland formula provides the initial fluid volume estimate, but fluids must be titrated up or down based on hourly urine output to ensure adequate resuscitation without over-resuscitation."
    },
    {
      "action_id": "assess_inhalation_injury_signs",
      "timestamp_minutes": 55.0,
      "type": "reassess",
      "args": {},
      "justification": "Optional but clinically critical: Inhalation injury significantly worsens burn prognosis and may require early intubation. Assessment of singed nasal hairs, hoarseness, carbonaceous sputum, and facial burns should be performed to identify this time-sensitive complication."
    },
    {
      "action_id": "give_100_percent_oxygen",
      "timestamp_minutes": 60.0,
      "type": "give_medication",
      "args": {
        "medication_code": "unknown",
        "dose": "standard"
      },
      "justification": "Burn patients with suspected inhalation injury should receive 100% oxygen via non-rebreather mask to treat potential carbon monoxide poisoning and support oxygenation."
    },
    {
      "action_id": "assess_burn_center_referral_criteria",
      "timestamp_minutes": 65.0,
      "type": "reassess",
      "args": {},
      "justification": "Evaluate whether this patient meets criteria for transfer to a specialized burn center based on TBSA, burn depth, location, and associated injuries per ABA guidelines."
    },
    {
      "action_id": "cover_with_clean_dry_dressing",
      "timestamp_minutes": 70.0,
      "type": "reassess",
      "args": {},
      "justification": "Cover burned areas with clean dry dressings to reduce infection risk, minimize heat loss, and protect wound integrity during the initial assessment phase."
    },
    {
      "action_id": "consult_burn_center",
      "timestamp_minutes": 75.0,
      "type": "consult",
      "args": {},
      "justification": "Patient has sustained burns requiring specialist evaluation. Burn center consultation is indicated to determine definitive care, guide ongoing management, and assess transfer criteria based on burn depth and TBSA already calculated."
    },
    {
      "action_id": "assess_compartment_pressures",
      "timestamp_minutes": 80.0,
      "type": "reassess",
      "args": {},
      "justification": "In burn patients, especially with circumferential or deep burns, compartment syndrome is a risk. Assessing compartment pressures helps detect this early and determine if escharotomy or fasciotomy is needed."
    },
    {
      "action_id": "assess_distal_pulses",
      "timestamp_minutes": 85.0,
      "type": "reassess",
      "args": {},
      "justification": "Monitoring distal pulses in burned extremities is essential to detect vascular compromise from edema or circumferential burns, guiding need for escharotomy."
    },
    {
      "action_id": "monitor_airway_patency",
      "timestamp_minutes": 90.0,
      "type": "order_lab",
      "args": {
        "test_code": "unknown"
      },
      "justification": "Burn patients with possible inhalation injury require continuous airway monitoring for progressive edema and obstruction, especially in the first hours post-injury."
    },
    {
      "action_id": "monitor_glucose_q4h",
      "timestamp_minutes": 95.0,
      "type": "order_lab",
      "args": {
        "test_code": "unknown"
      },
      "justification": "Serial glucose monitoring is important in burn patients to detect stress hyperglycemia or hypoglycemia, particularly with ongoing fluid resuscitation."
    },
    {
      "action_id": "give_iv_morphine",
      "timestamp_minutes": 100.0,
      "type": "give_medication",
      "args": {
        "medication_code": "unknown",
        "dose": "standard"
      },
      "justification": "Adequate analgesia is a priority in burn management. IV morphine provides appropriate pain control for burn patients while vitals are stable."
    },
    {
      "action_id": "order_carboxyhemoglobin",
      "timestamp_minutes": 105.0,
      "type": "reassess",
      "args": {},
      "justification": "Carboxyhemoglobin level is essential in burn patients to assess for carbon monoxide poisoning, particularly relevant since 100% oxygen has been administered and inhalation injury signs were assessed."
    },
    {

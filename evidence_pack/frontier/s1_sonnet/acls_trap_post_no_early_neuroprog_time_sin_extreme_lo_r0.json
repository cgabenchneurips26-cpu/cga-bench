    {
      "action_id": "begin_high_quality_cpr",
      "timestamp_minutes": 10.0,
      "type": "reassess",
      "args": {},
      "justification": "Begin high-quality CPR immediately per AHA ACLS guidelines. Minimizing interruptions to chest compressions is critical to survival. This is mandatory and time-critical."
    },
    {
      "action_id": "attach_defibrillator_pads",
      "timestamp_minutes": 15.0,
      "type": "reassess",
      "args": {},
      "justification": "MANDATORY action: Attach defibrillator pads immediately to allow rhythm analysis and potential defibrillation. This is the critical next step in ACLS for a pulseless patient \u2014 rhythm identification determines the entire treatment pathway (shockable vs. non-shockable)."
    },
    {
      "action_id": "analyze_rhythm",
      "timestamp_minutes": 20.0,
      "type": "reassess",
      "args": {},
      "justification": "After attaching pads, analyze the cardiac rhythm to differentiate VF/pVT (shockable \u2014 requires immediate defibrillation) from asystole/PEA (non-shockable \u2014 requires epinephrine and reversible cause evaluation per AHA ACLS guidelines)."
    },
    {
      "action_id": "apply_end_tidal_co2_monitoring",
      "timestamp_minutes": 25.0,
      "type": "order_lab",
      "args": {
        "test_code": "unknown"
      },
      "justification": "End-tidal CO2 monitoring provides real-time feedback on CPR quality and can serve as an early indicator of ROSC (return of spontaneous circulation). ETCO2 >10 mmHg during CPR indicates effective compressions; a sudden rise suggests ROSC."
    },
    {
      "action_id": "continue_high_quality_cpr",
      "timestamp_minutes": 30.0,
      "type": "reassess",
      "args": {},
      "justification": "Per AHA ACLS guidelines, continuous high-quality CPR is essential for asystole/PEA. The patient is unresponsive and pulseless; CPR must be maintained without interruption."
    },
    {
      "action_id": "establish_iv_io_access",
      "timestamp_minutes": 35.0,
      "type": "reassess",
      "args": {},
      "justification": "IV/IO access is required to administer epinephrine and other medications per ACLS protocol for asystole/PEA management."
    },
    {
      "action_id": "evaluate_reversible_causes",
      "timestamp_minutes": 40.0,
      "type": "reassess",
      "args": {},
      "justification": "AHA ACLS guidelines mandate evaluation of the Hs and Ts (reversible causes) in asystole/PEA: hypoxia, hypovolemia, hypothermia, hydrogen ion (acidosis), hypo/hyperkalemia, tension pneumothorax, tamponade, toxins, thrombosis (pulmonary/coronary)."
    },
    {
      "action_id": "continue_cpr",
      "timestamp_minutes": 45.0,
      "type": "reassess",
      "args": {},
      "justification": "Continuing high-quality CPR is essential to maintain perfusion during cardiac arrest. This is a core ACLS requirement throughout resuscitation."
    },
    {
      "action_id": "deliver_defibrillation",
      "timestamp_minutes": 50.0,
      "type": "reassess",
      "args": {},
      "justification": "If rhythm analysis revealed a shockable rhythm (VF/pVT), immediate defibrillation is the highest priority intervention per ACLS guidelines. Defibrillation should not be delayed."
    },
    {
      "action_id": "give_amiodarone_300mg",
      "timestamp_minutes": 55.0,
      "type": "give_medication",
      "args": {
        "medication_code": "unknown",
        "dose": "standard"
      },
      "justification": "Amiodarone 300mg IV is indicated for shock-refractory VF/pVT per ACLS guidelines, to be given after the second defibrillation attempt if VF/pVT persists."
    },
    {
      "action_id": "give_epinephrine_1mg_iv_immediately",
      "timestamp_minutes": 60.0,
      "type": "give_medication",
      "args": {
        "medication_code": "unknown",
        "dose": "standard"
      },
      "justification": "Per ACLS guidelines, epinephrine 1mg IV should be given as soon as feasible in cardiac arrest. This is a critical medication not yet administered and is listed as a required action in the guideline for asystole/PEA. Even in VF/pVT, epinephrine is indicated after the second shock (defibrillation already completed)."
    },
    {
      "action_id": "give_calcium_chloride",
      "timestamp_minutes": 65.0,
      "type": "give_medication",
      "args": {
        "medication_code": "unknown",
        "dose": "standard"
      },
      "justification": "Calcium chloride addresses reversible causes of cardiac arrest (hypocalcemia, hyperkalemia, calcium channel blocker toxicity). Given that reversible causes have been evaluated, calcium may be indicated as part of targeted therapy."
    },
    {
      "action_id": "continuous_eeg_monitoring",
      "timestamp_minutes": 70.0,
      "type": "order_lab",
      "args": {
        "test_code": "unknown"
      },
      "justification": "Continuous EEG monitoring is appropriate to assess for seizure activity and neurological status, particularly relevant post-cardiac arrest management and to guide ongoing care."
    },
    {
      "action_id": "give_epinephrine_1mg_iv",
      "timestamp_minutes": 75.0,
      "type": "give_medication",
      "args": {
        "medication_code": "unknown",
        "dose": "standard"
      },
      "justification": "Repeat epinephrine every 3-5 minutes is indicated per ACLS guidelines for ongoing cardiac arrest. Initial epinephrine was already given; repeat dosing is required to maintain coronary perfusion pressure during resuscitation."
    },
    {
      "action_id": "give_amiodarone_150mg_repeat",
      "timestamp_minutes": 80.0,
      "type": "give_medication",
      "args": {
        "medication_code": "unknown",
        "dose": "standard"
      },
      "justification": "Repeat amiodarone 150mg is indicated for refractory VF/pVT after initial 300mg dose has been given, per ACLS shock-refractory VF/pVT protocol."
    },
    {
      "action_id": "consider_double_sequential_defibrillation",
      "timestamp_minutes": 85.0,
      "type": "reassess",
      "args": {},
      "justification": "If rhythm check reveals persistent refractory VF/pVT despite multiple defibrillation attempts and antiarrhythmic therapy, double sequential defibrillation may be considered as a rescue strategy."

      "timestamp_minutes": 20.0,
      "type": "reassess",
      "args": {},
      "justification": "After attaching defibrillator pads, immediately analyze the cardiac rhythm to determine if rhythm is shockable (VF/pVT) or non-shockable (asystole/PEA), guiding whether to defibrillate or administer epinephrine first."
    },

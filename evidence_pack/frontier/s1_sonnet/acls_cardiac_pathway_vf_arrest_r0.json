  "actions": [
    {
      "action_id": "confirm_cardiac_arrest",
      "timestamp_minutes": 0.0,
      "type": "reassess",
      "args": {},
      "justification": "First step is to confirm cardiac arrest by checking for unresponsiveness, absence of normal breathing, and absence of pulse. This confirms the clinical syndrome before initiating resuscitation."
    },
    {
      "action_id": "activate_code_team",
      "timestamp_minutes": 5.0,
      "type": "order_imaging",
      "args": {
        "imaging_type": "ct"
      },
      "justification": "Immediately activate the code team to ensure adequate personnel for resuscitation efforts, including advanced airway management, IV access, and medication administration."
    },
    {
      "action_id": "begin_high_quality_cpr",
      "timestamp_minutes": 10.0,
      "type": "reassess",
      "args": {},
      "justification": "High-quality CPR (rate 100-120/min, depth 2-2.4 inches, full recoil, minimize interruptions) is the cornerstone of cardiac arrest management and must be initiated immediately to maintain perfusion."
    },
    {
      "action_id": "attach_defibrillator_pads",
      "timestamp_minutes": 15.0,
      "type": "order_lab",
      "args": {
        "test_code": "unknown"
      },
      "justification": "MANDATORY action - Attach defibrillator pads immediately to enable rhythm analysis and potential defibrillation. This is the critical next step in ACLS protocol after CPR initiation to identify shockable rhythms (VF/pVT)."
    },
    {
      "action_id": "analyze_rhythm",
      "timestamp_minutes": 20.0,
      "type": "reassess",
      "args": {},
      "justification": "After attaching pads, analyze the cardiac rhythm to determine if a shockable rhythm (VF/pulseless VT) is present, which would guide immediate defibrillation per ACLS guidelines."
    },
    {
      "action_id": "apply_end_tidal_co2_monitoring",
      "timestamp_minutes": 25.0,
      "type": "order_lab",
      "args": {
        "test_code": "unknown"
      },
      "justification": "End-tidal CO2 monitoring provides real-time feedback on CPR quality and can indicate ROSC when values rise above 40 mmHg, per ACLS guidelines for cardiac arrest management."
    },
    {
      "action_id": "establish_iv_io_access",
      "timestamp_minutes": 30.0,
      "type": "reassess",
      "args": {},
      "justification": "IV/IO access is essential for medication administration during cardiac arrest resuscitation. This is a foundational step in ACLS protocol after CPR has been initiated."
    },
    {
      "action_id": "evaluate_reversible_causes",
      "timestamp_minutes": 35.0,
      "type": "reassess",
      "args": {},
      "justification": "Identifying and treating reversible causes (Hs and Ts: hypoxia, hypovolemia, hydrogen ion, hypo/hyperkalemia, hypothermia, tension pneumothorax, tamponade, toxins, thrombosis) is a critical step in cardiac arrest management per ACLS guidelines."
    },
    {
      "action_id": "deliver_defibrillation",
      "timestamp_minutes": 40.0,
      "type": "reassess",
      "args": {},
      "justification": "If the rhythm analysis (already completed) identified a shockable rhythm (VF/pVT), defibrillation should be delivered promptly as early defibrillation is the most important intervention for shockable rhythms in cardiac arrest."
    },
    {
      "action_id": "continue_high_quality_cpr",
      "timestamp_minutes": 45.0,
      "type": "reassess",
      "args": {},
      "justification": "CPR has been initiated; continuing high-quality CPR is essential to maintain perfusion during cardiac arrest resuscitation."
    },
    {
      "action_id": "give_amiodarone_300mg",
      "timestamp_minutes": 50.0,
      "type": "give_medication",
      "args": {
        "medication_code": "unknown",
        "dose": "standard"
      },
      "justification": "Following defibrillation and ongoing CPR, amiodarone 300mg IV is indicated for refractory ventricular fibrillation/pulseless VT per ACLS guidelines."
    },
    {
      "action_id": "give_epinephrine_1mg_iv",
      "timestamp_minutes": 55.0,
      "type": "give_medication",
      "args": {
        "medication_code": "unknown",
        "dose": "standard"
      },
      "justification": "Epinephrine is a cornerstone of ACLS cardiac arrest management. Given prior amiodarone 300mg was administered and CPR is ongoing, repeat epinephrine every 3-5 minutes is indicated per ACLS guidelines to maintain coronary and cerebral perfusion pressure during resuscitation."
    },
    {
      "action_id": "give_amiodarone_150mg_repeat",
      "timestamp_minutes": 60.0,
      "type": "give_medication",
      "args": {
        "medication_code": "unknown",
        "dose": "standard"
      },
      "justification": "Following the initial 300mg amiodarone dose for refractory ventricular fibrillation/pulseless VT, a repeat dose of 150mg amiodarone is indicated per ACLS guidelines if the arrhythmia persists after additional defibrillation attempts."
    },
    {
      "action_id": "give_epinephrine_repeat_3_5min",
      "timestamp_minutes": 65.0,
      "type": "give_medication",
      "args": {
        "medication_code": "unknown",
        "dose": "standard"
      },
      "justification": "Epinephrine should be repeated every 3-5 minutes during cardiac arrest resuscitation per ACLS guidelines. Prior epinephrine was given and repeat dosing is indicated to maintain vasopressor support during ongoing resuscitation."
    },
    {
      "action_id": "continue_cpr",
      "timestamp_minutes": 70.0,
      "type": "reassess",
      "args": {},
      "justification": "High-quality CPR must be continued throughout cardiac arrest resuscitation to maintain perfusion pressure. This is a core ACLS intervention."
    },
    {
      "action_id": "continuous_eeg_monitoring",
      "timestamp_minutes": 75.0,
      "type": "order_lab",
      "args": {
        "test_code": "unknown"
      },
      "justification": "Continuous EEG monitoring is indicated to assess for post-cardiac arrest neurological status and detect subclinical seizure activity, especially as resuscitation progresses."
    },
    {
      "action_id": "admit_to_icu",
      "timestamp_minutes": 80.0,
      "type": "disposition",
      "args": {},
      "justification": "Patient has been resuscitated from cardiac arrest (given the completed ACLS actions) and now has stable vitals. Post-cardiac arrest care requires ICU admission for targeted temperature management, hemodynamic monitoring, and ongoing management per post-ROSC guidelines."
    }
  ],

      "timestamp_minutes": 10.0,
      "type": "reassess",
      "args": {},
      "justification": "Mandatory assessment of burn depth (superficial, partial thickness, full thickness) to classify severity and determine treatment plan."
    },
    {
      "action_id": "establish_iv_access",
      "timestamp_minutes": 15.0,
      "type": "reassess",
      "args": {},
      "justification": "Mandatory action - IV access is required for fluid resuscitation in burn patients per Parkland formula guidelines."
    },
    {
      "action_id": "estimate_tbsa",
      "timestamp_minutes": 20.0,
      "type": "reassess",
      "args": {},
      "justification": "Mandatory action - Total Body Surface Area burned must be estimated to calculate fluid resuscitation requirements using the Parkland formula."
    },
    {
      "action_id": "obtain_patient_weight",
      "timestamp_minutes": 25.0,
      "type": "reassess",
      "args": {},
      "justification": "Mandatory action - Patient weight is required along with TBSA to calculate the Parkland formula fluid resuscitation volume (4 mL/kg/%TBSA)."
    },
    {
      "action_id": "calculate_parkland_formula",
      "timestamp_minutes": 30.0,
      "type": "reassess",
      "args": {},
      "justification": "Calculate total fluid resuscitation volume using Parkland formula (4 mL \u00d7 kg \u00d7 %TBSA) now that patient weight and TBSA have been estimated. This determines the target fluid volume for the first 24 hours."
    },
    {
      "action_id": "place_foley_catheter",
      "timestamp_minutes": 35.0,
      "type": "reassess",
      "args": {},
      "justification": "Insert Foley catheter for accurate urine output measurement, which is the primary endpoint for guiding fluid resuscitation in burn patients (target 0.5 mL/kg/h in adults)."
    },
    {
      "action_id": "start_lactated_ringers",
      "timestamp_minutes": 40.0,
      "type": "give_medication",
      "args": {
        "medication_code": "unknown",
        "dose": "standard"
      },
      "justification": "Initiate Lactated Ringer's solution as per burn resuscitation guidelines. LR is the preferred isotonic crystalloid for burn resuscitation per Parkland formula."
    },
    {
      "action_id": "monitor_urine_output_target_0_5_ml_kg_h",
      "timestamp_minutes": 45.0,
      "type": "order_lab",
      "args": {
        "test_code": "unknown"
      },
      "justification": "MANDATORY: Urine output monitoring is the primary endpoint for fluid resuscitation adequacy in burn patients. Target is 0.5 ml/kg/h in adults per burn resuscitation guidelines. Foley catheter is already in place."
    },
    {
      "action_id": "titrate_fluids_to_urine_output",
      "timestamp_minutes": 50.0,
      "type": "give_medication",
      "args": {
        "medication_code": "fluid",
        "dose": "standard"
      },
      "justification": "MANDATORY: Lactated Ringer's rate should be titrated up or down based on urine output to maintain target of 0.5 ml/kg/h, avoiding both under-resuscitation and fluid overload."
    },
    {
      "action_id": "assess_inhalation_injury_signs",
      "timestamp_minutes": 55.0,
      "type": "reassess",
      "args": {},
      "justification": "Inhalation injury is a critical complication in burn patients that significantly increases mortality. Assessment of signs (singed nasal hairs, carbonaceous sputum, hoarseness, stridor) should be performed to determine if bronchoscopy or early intubation is needed."
    },
    {
      "action_id": "give_100_percent_oxygen",
      "timestamp_minutes": 60.0,
      "type": "give_medication",
      "args": {
        "medication_code": "unknown",
        "dose": "standard"
      },
      "justification": "High-flow 100% oxygen is indicated in burn patients to displace carbon monoxide and address potential inhalation injury, which is a standard early intervention in burn management."
    },
    {
      "action_id": "assess_burn_center_referral_criteria",
      "timestamp_minutes": 65.0,
      "type": "reassess",
      "args": {},
      "justification": "Assess whether this patient meets burn center referral criteria (e.g., TBSA >10%, full thickness burns, special areas affected, inhalation injury) as per ABA guidelines \u2014 a key step in burn triage."
    },
    {
      "action_id": "assess_distal_pulses",
      "timestamp_minutes": 70.0,
      "type": "reassess",
      "args": {},
      "justification": "Assess distal pulses to evaluate for vascular compromise or compartment syndrome from circumferential burns, which is a critical safety check in burn management."
    },
    {
      "action_id": "cover_with_clean_dry_dressing",
      "timestamp_minutes": 75.0,
      "type": "reassess",
      "args": {},
      "justification": "Covering burn wounds with clean dry dressings reduces infection risk, minimizes heat/fluid loss, and decreases pain while further assessment proceeds."
    },
    {
      "action_id": "assess_compartment_pressures",
      "timestamp_minutes": 80.0,
      "type": "reassess",
      "args": {},
      "justification": "In significant burn injuries, circumferential burns or fluid resuscitation can lead to compartment syndrome. Assessing compartment pressures is indicated especially given prior assessment of distal pulses."
    },
    {
      "action_id": "consult_burn_center",
      "timestamp_minutes": 85.0,
      "type": "consult",
      "args": {},
      "justification": "Burn center referral criteria have been assessed; formal consultation with burn center specialists should be initiated to guide ongoing management and potential transfer."
    },
    {
      "action_id": "monitor_airway_patency",
      "timestamp_minutes": 90.0,
      "type": "order_lab",
      "args": {
        "test_code": "unknown"
      },
      "justification": "Inhalation injury was assessed; ongoing airway patency monitoring is critical in burn patients as edema can develop progressively over the first hours, potentially compromising the airway."
    },
    {
      "action_id": "monitor_glucose_q4h",
      "timestamp_minutes": 95.0,
      "type": "order_lab",
      "args": {
        "test_code": "unknown"
      },
      "justification": "Burn patients are at risk for metabolic derangements including hyperglycemia and hypoglycemia; routine glucose monitoring every 4 hours is standard supportive care."
    },
    {
      "action_id": "give_iv_morphine",
      "timestamp_minutes": 100.0,
      "type": "give_medication",
      "args": {
        "medication_code": "unknown",
        "dose": "standard"
      },
      "justification": "Burn patients require adequate analgesia; IV morphine is appropriate for moderate-to-severe burn pain management in a hemodynamically stable patient (HR 80, BP 120/80)."
    },
    {
      "action_id": "order_carboxyhemoglobin",
      "timestamp_minutes": 105.0,
      "type": "reassess",
      "args": {},
      "justification": "Carboxyhemoglobin level is essential in burn patients to assess carbon monoxide poisoning, especially with inhalation injury concerns. This guides need for continued high-flow O2 therapy and possible hydroxocobalamin if cyanide poisoning is also suspected."
    },
    {

  "actions": [
    {
      "action_id": "assess_airway",
      "timestamp_minutes": 0.0,
      "type": "reassess",
      "args": {},
      "justification": "Airway assessment is the highest priority in burn patients due to risk of inhalation injury and upper airway edema that can rapidly compromise the airway. Must be done immediately on arrival."
    },
    {
      "action_id": "assess_vital_signs",
      "timestamp_minutes": 5.0,
      "type": "reassess",
      "args": {},
      "justification": "Baseline vital signs assessment is mandatory to establish hemodynamic status and guide resuscitation planning for this burn patient."
    },
    {
      "action_id": "assess_burn_depth",
      "timestamp_minutes": 10.0,
      "type": "reassess",
      "args": {},
      "justification": "Assessment of burn depth (superficial, partial thickness, full thickness) is mandatory to classify severity, guide treatment decisions, and determine need for burn center referral."
    },
    {
      "action_id": "establish_iv_access",
      "timestamp_minutes": 15.0,
      "type": "reassess",
      "args": {},
      "justification": "Mandatory action - IV access is essential for fluid resuscitation in burn patients. Must be established early to begin Parkland formula fluid administration."
    },
    {
      "action_id": "estimate_tbsa",
      "timestamp_minutes": 20.0,
      "type": "reassess",
      "args": {},
      "justification": "Mandatory action - Total Body Surface Area burned must be estimated (using Rule of Nines or Lund-Browder chart) to calculate fluid resuscitation requirements via the Parkland formula."
    },
    {
      "action_id": "obtain_patient_weight",
      "timestamp_minutes": 25.0,
      "type": "reassess",
      "args": {},
      "justification": "Mandatory action - Patient weight is required along with TBSA to calculate the Parkland formula: 4 mL \u00d7 kg \u00d7 %TBSA burned for the first 24 hours of fluid resuscitation."
    },
    {
      "action_id": "calculate_parkland_formula",
      "timestamp_minutes": 30.0,
      "type": "reassess",
      "args": {},
      "justification": "Calculate total fluid resuscitation volume using Parkland formula (4 mL \u00d7 kg \u00d7 %TBSA) now that patient weight and TBSA have been assessed. This determines the LR volume to administer over 24 hours."
    },
    {
      "action_id": "place_foley_catheter",
      "timestamp_minutes": 35.0,
      "type": "reassess",
      "args": {},
      "justification": "Place Foley catheter to accurately monitor urine output, which is the primary endpoint for fluid resuscitation adequacy in burn patients (target 0.5 mL/kg/h)."
    },
    {
      "action_id": "start_lactated_ringers",
      "timestamp_minutes": 40.0,
      "type": "give_medication",
      "args": {
        "medication_code": "unknown",
        "dose": "standard"
      },
      "justification": "Initiate IV lactated Ringer's solution per Parkland formula. Half the calculated volume should be given in the first 8 hours from time of burn injury. LR is preferred over NS to avoid hyperchloremic acidosis."
    },
    {
      "action_id": "monitor_urine_output_target_0_5_ml_kg_h",
      "timestamp_minutes": 45.0,
      "type": "order_lab",
      "args": {
        "test_code": "unknown"
      },
      "justification": "Mandatory action: Urine output monitoring targeting 0.5 ml/kg/h is the primary endpoint for fluid resuscitation adequacy in burn patients per Parkland protocol. Foley catheter is already in place."
    },
    {
      "action_id": "titrate_fluids_to_urine_output",
      "timestamp_minutes": 50.0,
      "type": "give_medication",
      "args": {
        "medication_code": "fluid",
        "dose": "standard"
      },
      "justification": "Mandatory action: Lactated Ringer's infusion rate should be titrated based on urine output to achieve 0.5 ml/kg/h target, adjusting up or down as needed per burn resuscitation guidelines."
    },
    {
      "action_id": "assess_inhalation_injury_signs",
      "timestamp_minutes": 55.0,
      "type": "reassess",
      "args": {},
      "justification": "Inhalation injury assessment is critical in burn patients as it significantly affects prognosis and management. Signs such as singed nasal hairs, carbonaceous sputum, hoarseness, or facial burns should be evaluated to determine if bronchoscopy or advanced airway management is needed."
    },
    {
      "action_id": "give_100_percent_oxygen",
      "timestamp_minutes": 60.0,
      "type": "give_medication",
      "args": {
        "medication_code": "unknown",
        "dose": "standard"
      },
      "justification": "High-flow 100% oxygen is indicated in burn patients to treat potential carbon monoxide poisoning and inhalation injury, even if SpO2 appears normal on pulse oximetry (which cannot distinguish COHb)."
    },
    {
      "action_id": "assess_burn_center_referral_criteria",
      "timestamp_minutes": 65.0,
      "type": "reassess",
      "args": {},
      "justification": "Burn center referral criteria should be assessed early to determine if transfer is needed (e.g., significant TBSA, full-thickness burns, burns to face/hands/feet/genitalia, inhalation injury, circumferential burns)."
    },
    {
      "action_id": "cover_with_clean_dry_dressing",
      "timestamp_minutes": 70.0,
      "type": "reassess",
      "args": {},
      "justification": "Covering burn wounds with clean dry dressings helps prevent infection, reduces heat loss, and provides comfort while definitive wound care is arranged."
    },
    {
      "action_id": "consult_burn_center",
      "timestamp_minutes": 75.0,
      "type": "consult",
      "args": {},
      "justification": "Given the burn injury with completed TBSA estimation and Parkland formula calculation, burn center consultation is indicated to guide ongoing management and determine need for transfer."
    },
    {
      "action_id": "assess_compartment_pressures",
      "timestamp_minutes": 80.0,
      "type": "reassess",
      "args": {},
      "justification": "Burn patients are at risk for compartment syndrome, especially with circumferential burns. Assessing compartment pressures is important for identifying need for escharotomy."
    },
    {
      "action_id": "assess_distal_pulses",
      "timestamp_minutes": 85.0,
      "type": "reassess",
      "args": {},
      "justification": "Distal pulse assessment helps evaluate for vascular compromise from circumferential burns or edema, complementing compartment pressure assessment."
    },
    {
      "action_id": "monitor_airway_patency",
      "timestamp_minutes": 90.0,
      "type": "order_lab",
      "args": {
        "test_code": "unknown"
      },
      "justification": "Airway monitoring is critical in burn patients, especially following inhalation injury assessment. Edema can develop progressively and airway patency must be continuously reassessed."
    },
    {
      "action_id": "bronchoscopy_if_suspected",
      "timestamp_minutes": 95.0,
      "type": "order_imaging",
      "args": {
        "imaging_type": "ct"
      },
      "justification": "If inhalation injury signs were identified during assessment, bronchoscopy is indicated to confirm diagnosis and assess extent of airway injury."
    },
    {
      "action_id": "monitor_glucose_q4h",
      "timestamp_minutes": 100.0,
      "type": "order_lab",
      "args": {
        "test_code": "unknown"
      },
      "justification": "Burn patients are at risk for metabolic disturbances including hyperglycemia due to stress response; regular glucose monitoring every 4 hours is standard care."
    },
    {
      "action_id": "order_carboxyhemoglobin",
      "timestamp_minutes": 105.0,
      "type": "reassess",
      "args": {},
      "justification": "Carboxyhemoglobin level is essential in burn patients with potential inhalation injury to assess degree of CO poisoning, even after initiating 100% oxygen therapy. Results guide duration of oxygen therapy."
    },
    {
      "action_id": "order_chest_xray",
      "timestamp_minutes": 110.0,
      "type": "order_imaging",
      "args": {
        "imaging_type": "xray"
      },
      "justification": "Chest X-ray is indicated in burn patients with suspected inhalation injury to assess for pulmonary infiltrates, barotrauma, or other complications. Baseline imaging important for monitoring progression."
    },
    {

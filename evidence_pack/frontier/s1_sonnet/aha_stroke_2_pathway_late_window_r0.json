      "type": "reassess",
      "args": {},
      "justification": "Establishing last known well time is critical to determine eligibility for tPA (within 4.5 hours) and mechanical thrombectomy (within 6-24 hours depending on imaging criteria)."
    },
    {
      "action_id": "perform_nihss",
      "timestamp_minutes": 10.0,
      "type": "reassess",
      "args": {},
      "justification": "NIHSS score quantifies stroke severity, guides treatment decisions (tPA eligibility, thrombectomy candidacy), and establishes baseline neurological status."
    },
    {
      "action_id": "order_stat_ct_head",
      "timestamp_minutes": 15.0,
      "type": "order_imaging",
      "args": {
        "imaging_type": "ct"
      },
      "justification": "Mandatory first-line imaging to exclude hemorrhage and identify ischemic changes in suspected ischemic stroke. Must be completed within 60 minutes of arrival."
    },
    {
      "action_id": "check_glucose",
      "timestamp_minutes": 20.0,
      "type": "order_lab",
      "args": {
        "test_code": "unknown"
      },
      "justification": "Mandatory assessment to rule out hypoglycemia as a stroke mimic and to guide management. Hypoglycemia can present with focal neurological deficits."
    },
    {
      "action_id": "establish_iv_access",
      "timestamp_minutes": 25.0,
      "type": "reassess",
      "args": {},
      "justification": "Mandatory for medication administration, lab draws, and potential tPA delivery. Essential early step in stroke management."
    },
    {
      "action_id": "obtain_12_lead_ecg",
      "timestamp_minutes": 30.0,
      "type": "order_imaging",
      "args": {
        "imaging_type": "ecg"
      },
      "justification": "Mandatory action per stroke protocol. ECG is required to identify atrial fibrillation or other cardiac arrhythmias that may be the source of cardioembolic stroke, and to rule out concurrent cardiac events."
    },
    {
      "action_id": "order_cbc_bmp_coag",
      "timestamp_minutes": 35.0,
      "type": "order_lab",
      "args": {
        "test_code": "cbc"
      },
      "justification": "Mandatory action per stroke protocol. CBC, BMP, and coagulation studies are essential to assess for contraindications to thrombolysis (e.g., thrombocytopenia, coagulopathy), electrolyte abnormalities, and renal function prior to any treatment decisions."
    },
    {
      "action_id": "assess_prestroke_mrs",
      "timestamp_minutes": 40.0,
      "type": "reassess",
      "args": {},
      "justification": "Assessing pre-stroke modified Rankin Scale (mRS) is a critical optional step to establish baseline functional status, which directly informs eligibility and decision-making for thrombolysis and thrombectomy."
    },
    {
      "action_id": "assess_aspects_score",
      "timestamp_minutes": 45.0,
      "type": "order_imaging",
      "args": {
        "imaging_type": "ct"
      },
      "justification": "After stat CT head has been obtained, the ASPECTS score should be calculated to assess extent of early ischemic changes, which guides eligibility for thrombolysis and mechanical thrombectomy per stroke guidelines."
    },
    {
      "action_id": "activate_neurointerventional_team",
      "timestamp_minutes": 50.0,
      "type": "order_imaging",
      "args": {
        "imaging_type": "ct"
      },
      "justification": "Early activation of the neurointerventional team is critical in acute ischemic stroke to minimize door-to-groin time if large vessel occlusion is identified and mechanical thrombectomy is indicated."
    },
    {
      "action_id": "assess_surgical_risk",
      "timestamp_minutes": 55.0,
      "type": "reassess",
      "args": {},
      "justification": "Assessing surgical risk is part of the workup to determine eligibility for interventional procedures such as mechanical thrombectomy in the setting of acute ischemic stroke."
    },
    {
      "action_id": "assess_vital_signs",
      "timestamp_minutes": 60.0,
      "type": "reassess",
      "args": {},
      "justification": "Serial vital sign monitoring is essential for this ischemic stroke patient to detect hemodynamic instability, hypertension requiring management, or deterioration."
    },
    {
      "action_id": "admit_to_icu_or_stroke_unit",
      "timestamp_minutes": 65.0,
      "type": "disposition",
      "args": {},
      "justification": "Ischemic stroke patients require admission to a stroke unit or ICU for continuous monitoring and specialized stroke care per guidelines."
    }

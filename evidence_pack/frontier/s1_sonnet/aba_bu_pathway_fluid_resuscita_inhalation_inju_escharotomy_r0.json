      "timestamp_minutes": 45.0,
      "type": "reassess",
      "args": {},
      "justification": "Foley catheter placement is mandatory to accurately monitor urine output, which is the primary endpoint for fluid resuscitation in burn patients per Parkland formula guidelines."
    },

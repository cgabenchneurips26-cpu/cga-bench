      "type": "reassess",
      "args": {},
      "justification": "\u2605 MANDATORY: Confirm pulselessness and unresponsiveness to establish cardiac arrest diagnosis and initiate the resuscitation protocol."
    },
    {
      "action_id": "activate_code_team",
      "timestamp_minutes": 5.0,
      "type": "order_imaging",
      "args": {
        "imaging_type": "ct"
      },
      "justification": "\u2605 MANDATORY: Activate the full code team immediately, including obstetric team given the patient's pregnancy, to ensure adequate resources for resuscitation."
    },
    {
      "action_id": "begin_high_quality_cpr",
      "timestamp_minutes": 10.0,
      "type": "reassess",
      "args": {},
      "justification": "\u2605 MANDATORY: Initiate high-quality CPR (100-120 compressions/min, adequate depth) immediately \u2014 minimizing time without circulation is critical for survival."
    },
    {
      "action_id": "attach_defibrillator_pads",
      "timestamp_minutes": 15.0,
      "type": "reassess",
      "args": {},
      "justification": "MANDATORY action: Attach defibrillator pads immediately to allow rhythm analysis and potential defibrillation. This is critical for determining whether the arrest is shockable (VF/pVT) or non-shockable (asystole/PEA) and guides all subsequent ACLS interventions."
    },
    {
      "action_id": "analyze_rhythm",
      "timestamp_minutes": 20.0,
      "type": "reassess",
      "args": {},
      "justification": "After attaching pads, analyze the cardiac rhythm to differentiate between shockable rhythms (VF/pVT requiring immediate defibrillation) and non-shockable rhythms (asystole/PEA requiring epinephrine and reversible cause evaluation per ACLS guidelines)."
    },
    {
      "action_id": "apply_end_tidal_co2_monitoring",
      "timestamp_minutes": 25.0,
      "type": "order_lab",
      "args": {
        "test_code": "unknown"
      },
      "justification": "End-tidal CO2 monitoring provides real-time feedback on CPR quality and can detect return of spontaneous circulation (ROSC). ETCO2 >10 mmHg indicates effective CPR; sudden rise to >40 mmHg suggests ROSC. Particularly important in this pregnant patient to optimize resuscitation."
    },
    {
      "action_id": "continue_high_quality_cpr",
      "timestamp_minutes": 30.0,
      "type": "reassess",
      "args": {},
      "justification": "High-quality CPR is the cornerstone of cardiac arrest management per AHA ACLS guidelines. Must be maintained continuously to ensure perfusion."
    },
    {
      "action_id": "evaluate_reversible_causes",
      "timestamp_minutes": 35.0,
      "type": "reassess",
      "args": {},
      "justification": "Per AHA ACLS guidelines for asystole/PEA, identifying and treating reversible causes (4H's: hypoxia, hypovolemia, hydrogen ion/acidosis, hypo/hyperkalemia; 4T's: tension pneumothorax, tamponade, toxins, thrombosis) is critical. Pregnancy adds specific reversible causes such as aortocaval compression and perimortem considerations."
    },
    {
      "action_id": "establish_iv_io_access",
      "timestamp_minutes": 40.0,
      "type": "reassess",
      "args": {},
      "justification": "IV/IO access is required to administer epinephrine and other resuscitation medications per ACLS protocol. This is a necessary next step after CPR initiation."
    },
    {
      "action_id": "continue_cpr",
      "timestamp_minutes": 45.0,
      "type": "reassess",
      "args": {},
      "justification": "High-quality CPR must be continued without interruption per ACLS guidelines for cardiac arrest. This is the cornerstone of resuscitation while other interventions are being prepared."
    },
    {
      "action_id": "deliver_defibrillation",
      "timestamp_minutes": 50.0,
      "type": "reassess",
      "args": {},
      "justification": "If rhythm analysis revealed a shockable rhythm (VF/pVT), immediate defibrillation is the highest priority per ACLS guidelines. Defibrillator pads are already attached."
    },
    {
      "action_id": "give_calcium_chloride",
      "timestamp_minutes": 55.0,
      "type": "give_medication",
      "args": {
        "medication_code": "unknown",
        "dose": "standard"
      },
      "justification": "In a pregnant patient, calcium chloride addresses potential reversible causes of cardiac arrest including hypocalcemia or hypermagnesemia (if magnesium was administered for eclampsia), which are H's and T's reversible causes already being evaluated."
    },
    {
      "action_id": "give_epinephrine_1mg_iv_immediately",

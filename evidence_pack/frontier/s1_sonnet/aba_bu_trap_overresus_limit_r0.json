      "type": "reassess",
      "args": {},
      "justification": "Mandatory first step in burn management - airway assessment is critical to identify inhalation injury, airway edema, or compromise that may require immediate intervention."
    },
    {
      "action_id": "assess_vital_signs",
      "timestamp_minutes": 5.0,
      "type": "reassess",
      "args": {},
      "justification": "Mandatory baseline vital signs assessment to establish hemodynamic status and guide resuscitation in burn patient."
    },
    {
      "action_id": "assess_burn_depth",
      "timestamp_minutes": 10.0,
      "type": "reassess",
      "args": {},
      "justification": "Mandatory assessment to classify burn severity (superficial, partial thickness, full thickness) which guides treatment decisions and fluid resuscitation."
    },
    {
      "action_id": "establish_iv_access",
      "timestamp_minutes": 15.0,
      "type": "reassess",
      "args": {},
      "justification": "Mandatory action: IV access is essential for fluid resuscitation in burn patients. Must be established early to begin Parkland formula fluid replacement."
    },
    {
      "action_id": "estimate_tbsa",
      "timestamp_minutes": 20.0,
      "type": "reassess",
      "args": {},
      "justification": "Mandatory action: Total Body Surface Area (TBSA) estimation is required to calculate fluid resuscitation volumes using the Parkland formula and determine burn severity."
    },
    {
      "action_id": "obtain_patient_weight",
      "timestamp_minutes": 25.0,
      "type": "reassess",
      "args": {},
      "justification": "Mandatory action: Patient weight is required for Parkland formula calculation (4 mL/kg/% TBSA burned) to determine appropriate fluid resuscitation volumes."
    },
    {
      "action_id": "calculate_parkland_formula",
      "timestamp_minutes": 30.0,
      "type": "reassess",
      "args": {},
      "justification": "Calculate the Parkland formula (4 mL \u00d7 kg \u00d7 %TBSA) to determine the total fluid volume needed in the first 24 hours of burn resuscitation. This is mandatory and guides all subsequent fluid management."
    },
    {
      "action_id": "place_foley_catheter",
      "timestamp_minutes": 35.0,
      "type": "reassess",
      "args": {},
      "justification": "Place Foley catheter to accurately monitor urine output, which is the primary endpoint for fluid resuscitation titration in burn patients (target 0.5 mL/kg/h in adults)."
    },
    {
      "action_id": "start_lactated_ringers",
      "timestamp_minutes": 40.0,
      "type": "give_medication",
      "args": {
        "medication_code": "unknown",
        "dose": "standard"
      },
      "justification": "Initiate lactated Ringer's solution as the standard resuscitation fluid for burn patients per the Parkland formula. Half of the calculated volume should be given in the first 8 hours post-burn."
    },
    {
      "action_id": "monitor_urine_output_target_0_5_ml_kg_h",
      "timestamp_minutes": 45.0,
      "type": "order_lab",
      "args": {
        "test_code": "unknown"
      },
      "justification": "MANDATORY: Urine output monitoring is the primary endpoint for burn resuscitation adequacy. Target is 0.5 ml/kg/h in adults. Foley catheter is already in place, so this should be actively tracked now."
    },
    {
      "action_id": "titrate_fluids_to_urine_output",
      "timestamp_minutes": 50.0,
      "type": "give_medication",
      "args": {
        "medication_code": "fluid",
        "dose": "standard"
      },
      "justification": "MANDATORY: Fluid resuscitation rate (Lactated Ringer's per Parkland formula) must be titrated based on urine output to avoid under- or over-resuscitation in burn patients."
    },
    {
      "action_id": "assess_inhalation_injury_signs",
      "timestamp_minutes": 55.0,
      "type": "reassess",
      "args": {},
      "justification": "Inhalation injury is a critical complication in burn patients that significantly affects prognosis and may require early intubation. Assessment should be performed early in the evaluation phase."
    },
    {
      "action_id": "assess_burn_center_referral_criteria",
      "timestamp_minutes": 60.0,
      "type": "reassess",
      "args": {},
      "justification": "After completing initial burn assessment (TBSA, depth, airway, fluid resuscitation), evaluate whether this patient meets criteria for transfer to a burn center per ABA guidelines (e.g., >10% TBSA partial thickness, full thickness burns, burns involving face/hands/feet/genitalia/major joints, inhalation injury, etc.)."
    },
    {
      "action_id": "give_100_percent_oxygen",
      "timestamp_minutes": 65.0,
      "type": "give_medication",
      "args": {
        "medication_code": "unknown",
        "dose": "standard"
      },
      "justification": "If inhalation injury signs were assessed, high-flow 100% oxygen via non-rebreather mask is indicated to treat potential carbon monoxide poisoning and support respiratory function in burn patients with suspected inhalation injury."
    },
    {
      "action_id": "cover_with_clean_dry_dressing",
      "timestamp_minutes": 70.0,
      "type": "reassess",
      "args": {},
      "justification": "Apply clean dry dressings to burn wounds to prevent infection, reduce heat loss, and protect wound integrity while further management is arranged."
    },
    {
      "action_id": "consult_burn_center",
      "timestamp_minutes": 75.0,
      "type": "consult",
      "args": {},
      "justification": "Burn center referral criteria have been assessed; now formally consult the burn center for specialist guidance on management and potential transfer of this burn patient."
    },
    {
      "action_id": "assess_compartment_pressures",
      "timestamp_minutes": 80.0,
      "type": "reassess",
      "args": {},
      "justification": "With fluid resuscitation ongoing, assess for compartment syndrome, especially in circumferential burns or extremity involvement, as early detection is critical."
    },
    {
      "action_id": "assess_distal_pulses",
      "timestamp_minutes": 85.0,
      "type": "reassess",
      "args": {},
      "justification": "Assess distal pulses to evaluate for vascular compromise or evolving compartment syndrome in burned extremities, guiding need for escharotomy."
    },
    {
      "action_id": "monitor_airway_patency",
      "timestamp_minutes": 90.0,
      "type": "order_lab",
      "args": {
        "test_code": "unknown"
      },
      "justification": "Inhalation injury was assessed and 100% O2 was given - ongoing airway monitoring is critical in burn patients as airway edema can develop progressively over hours."
    },
    {
      "action_id": "bronchoscopy_if_suspected",
      "timestamp_minutes": 95.0,
      "type": "order_imaging",
      "args": {
        "imaging_type": "ct"
      },
      "justification": "Given that inhalation injury signs were assessed and 100% oxygen was administered, bronchoscopy may be indicated to confirm inhalation injury diagnosis and assess airway involvement."
    },
    {
      "action_id": "monitor_glucose_q4h",
      "timestamp_minutes": 100.0,
      "type": "order_lab",
      "args": {
        "test_code": "unknown"
      },
      "justification": "Burn patients are at risk for metabolic derangements including hyperglycemia due to the stress response; regular glucose monitoring is appropriate supportive care."
    },
    {
      "action_id": "order_carboxyhemoglobin",
      "timestamp_minutes": 105.0,
      "type": "reassess",
      "args": {},

  "practice_points": {
    "4.3.2.1": {
      "text": "In people with CKD G3a-G5, use the lowest possible dose of contrast media for imaging studies.",
      "applies_to": "CKD G3a-G5",
      "action": "Minimize contrast dose"
    },
    "4.3.2.2": {
      "text": "Ensure adequate hydration before and after contrast media exposure in people with CKD.",
      "applies_to": "All CKD patients receiving contrast",
      "action": "Pre- and post-hydration"
    },
    "4.3.2.3": {
      "text": "Consider withholding metformin for 48 hours after contrast exposure in people with CKD G3b-G5.",
      "applies_to": "CKD G3b-G5 on metformin",
      "action": "Hold metformin 48h post-contrast"
    }
  },
